#!/bin/sh

# Load nvm to ensure correct Node version in GUI apps (e.g. GitKraken)
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use default --silent
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
BORROWER_DIR="$REPO_ROOT/frontend/borrower"

STAGED_BORROWER_FILES=$(git diff --cached --name-only -- "frontend/borrower/")

if [ -n "$STAGED_BORROWER_FILES" ] && [ -d "$BORROWER_DIR" ]; then
  cd "$BORROWER_DIR"
  pnpm run lint:staged || {
    echo "ESLint found errors, commit aborted."
    exit 1
  }
fi
