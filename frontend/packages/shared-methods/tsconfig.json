{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"baseUrl": ".",
		"outDir": "dist",
		"rootDir": "src",
		"paths": {
			"@/*": ["./src/*"],
			"@/lib/*": ["./src/lib/*"],
			"@/utils": ["./src/utils.js"],
			"@/api/*": ["./src/api/*"],
			"@/assets/*": ["./src/assets/*"],
			"@/hooks/*": ["./src/hooks/*"],
			"@/components/*": ["./src/components/*"],
			"@public*": ["./public/*"]
		}
	},
	"include": ["src"]
}
