{
	"name": "@repo/shared-methods",
	"version": "1.0.0",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"import": "./src/index.ts",
			"require": "./src/index.ts"
		},
		"./utils": {
			"import": "./src/utils.js",
			"require": "./src/utils.js"
		},
		"./lib/*": {
			"import": "./src/lib/*.js",
			"require": "./src/lib/*.js"
		},
		"./hooks/*": {
			"import": "./src/hooks/*",
			"require": "./src/hooks/*"
		},
		"./api/*": {
			"import": "./src/api/*",
			"require": "./src/api/*"
		},
		"./components/*": {
			"import": "./src/components/*",
			"require": "./src/components/*"
		},
		"./assets/*": {
			"import": "./src/assets/*",
			"require": "./src/assets/*"
		},
		"./enum/*": {
			"import": "./src/enum/*",
			"require": "./src/enum/*"
		}
	},
	"private": true,
	"peerDependencies": {
		"@ant-design/icons": "~5.6.1",
		"@ant-design/nextjs-registry": "^1.0.2",
		"@ant-design/v5-patch-for-react-19": "^1.0.3",
		"@eslint/eslintrc": "^3",
		"@eslint/js": "^9.38.0",
		"@next/eslint-plugin-next": "^15.5.6",
		"@svgr/webpack": "^8.1.0",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@typescript-eslint/eslint-plugin": "^8.35.0",
		"@typescript-eslint/parser": "^8.46.2",
		"antd": "^5.26.2",
		"autoprefixer": "^10.4.21",
		"dayjs": "^1.11.13",
		"eslint": "^9",
		"eslint-config-next": "15.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.0",
		"events": "^3.3.0",
		"lodash": "^4.17.21",
		"next": "15.3.0",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-draggable": "^4.5.0",
		"react-signature-pad-wrapper": "^4.1.1",
		"sass": "^1.89.2",
		"tailwindcss": "^3.4.17",
		"typescript": "^5"
	},
	"dependencies": {
		"react-virtuoso": "^4.16.1",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2"
	}
}
