{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"],
			"@/store/*": ["./src/store/*"],
			"@/lib/*": ["./src/lib/*"],
			"@/api/*": ["./src/api/*"],
			"@/assets/*": ["./src/assets/*"],
			"@/enum/*": ["./src/enum/*"],
			"@/config/*": ["./config/*"],
			"@/components/*": ["./src/components/*"],
			"@/i18n/*": ["./src/i18n/*"],
			"@repo/platform-core": ["../packages/platform-core/src"],
			"@repo/platform-core/*": ["../packages/platform-core/src/*"]
		}
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
