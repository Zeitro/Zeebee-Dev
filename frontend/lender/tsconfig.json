{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/store/*": ["./src/store/*"],
      "@/lib/*": ["./src/lib/*"] ,
      "@/api/*": ["./src/api/*"] ,
      "@/assets/*": ["./src/assets/*"] ,
      "@config/*": ["./config/*"] ,
      "@images/*": ["./public/images*"],
      "@repo/shared-methods": ["../packages/shared-methods/src"],
			"@repo/shared-methods/*": ["../packages/shared-methods/src/*"] 
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
