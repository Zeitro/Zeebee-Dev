{
	"singleQuote": true,
	"trailingComma": "all",
	"printWidth": 100,
	"tabWidth": 4,
	"useTabs": true,
	"arrowParens": "always",
	"endOfLine": "auto",
	"overrides": [
		{
			"files": ".prettierrc",
			"options": {
				"parser": "json"
			}
		},
		{
			"files": "*.json",
			"options": {
				"tabWidth": 4,
				"useTabs": true
			}
		},
		{
			"files": "*.css",
			"options": {
				"tabWidth": 4,
				"useTabs": true
			}
		}
	]
}
