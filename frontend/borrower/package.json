{
	"name": "next-demo-ts",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"local": "cross-env NEXT_PUBLIC_ENV=local next dev",
		"dev": "cross-env NODE_ENV=development next start",
		"build": "cross-env NODE_ENV=production next build",
		"start": "cross-env NODE_ENV=production next start",
		"lint": "next lint",
		"format": "prettier --write .",
		"clean": "rm -rf .next dist build",
		"check-env": "env | grep NEXT_PUBLIC",
		"prepare": "husky"
	},
	"lint-staged": {
		"**/*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"**/*.{json,md,css}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@ant-design/nextjs-registry": "^1.0.2",
		"@ant-design/v5-patch-for-react-19": "^1.0.3",
		"@svgr/webpack": "^8.1.0",
		"antd": "^5.26.2",
		"dayjs": "^1.11.13",
		"events": "^3.3.0",
		"lodash": "^4.17.21",
		"next": "15.3.0",
		"next-svg": "^1.0.7",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"zustand": "^5.0.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@typescript-eslint/eslint-plugin": "^8.35.0",
		"autoprefixer": "^10.4.21",
		"cross-env": "^10.0.0",
		"eslint": "^9",
		"eslint-config-next": "15.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.1",
		"eslint-plugin-react": "^7.37.5",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.5",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"sass": "^1.89.2",
		"tailwindcss": "^3.4.17",
		"typescript": "^5"
	},
	"type": "module"
}
