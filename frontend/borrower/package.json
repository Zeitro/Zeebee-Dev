{
	"name": "next-borrower",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"local": "cross-env NODE_ENV=development NEXT_PUBLIC_ENV=local next dev -p 3000",
		"dev": "cross-env NODE_ENV=development next start",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"format": "prettier --write .",
		"eslint": "eslint --fix",
		"lint:staged": "lint-staged",
		"clean": "rm -rf .next dist build",
		"check-env": "env | grep NEXT_PUBLIC"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,scss}": [
			"eslint --quiet --fix",
			"prettier --write"
		]
	},
	"dependencies": {
		"@ant-design/icons": "~5.6.1",
		"@ant-design/nextjs-registry": "^1.0.2",
		"@ant-design/v5-patch-for-react-19": "^1.0.3",
		"@repo/shared-methods": "workspace:*",
		"@svgr/webpack": "^8.1.0",
		"antd": "^5.26.2",
		"aws-sdk": "^2.1692.0",
		"dayjs": "^1.11.13",
		"events": "^3.3.0",
		"lodash": "^4.17.21",
		"next": "15.3.0",
		"pdfjs-dist": "5.3.31",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-draggable": "^4.5.0",
		"react-pdf": "10.0.1",
		"react-signature-pad-wrapper": "^4.1.1",
		"zustand": "^5.0.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@eslint/js": "^9.38.0",
		"@next/eslint-plugin-next": "^15.5.6",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/react-pdf": "^7.0.0",
		"@typescript-eslint/eslint-plugin": "^8.35.0",
		"@typescript-eslint/parser": "^8.46.2",
		"autoprefixer": "^10.4.21",
		"cross-env": "^10.0.0",
		"eslint": "^9",
		"eslint-config-next": "15.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.0",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"sass": "^1.89.2",
		"tailwindcss": "^3.4.17",
		"typescript": "^5"
	},
	"type": "module",
	"pnpm": {
		"publicHoistPattern": [
			"pdfjs-dist"
		]
	},
	"resolutions": {
		"pdfjs-dist": "5.3.31"
	}
}
