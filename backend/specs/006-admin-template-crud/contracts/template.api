syntax = "v1"

info(
    title: "template-api"
    desc: "template management http service description"
    version: "v1"
)

import "common.api"

type TemplateVariableEntity struct {
    Label        string                              `json:"label"`
    Type         string                              `json:"type"`
    Key          string                              `json:"key"`
    IsEditable   bool                                `json:"is_editable"`
    Source       string                              `json:"source"`
    FixedValue   any                                 `json:"fixed_value"`
    ExampleValue any                                 `json:"example_value,omitempty"`
    Properties   map[string]*TemplateVariableEntity   `json:"properties,omitempty"`
    Items        []*TemplateVariableEntity            `json:"items,omitempty"`
}

type TemplateVariableGroupEntity struct {
    Name      string                   `json:"name"`
    Variables []*TemplateVariableEntity `json:"variables"`
}

// Entity
type (
    BaseTemplateEntity {
        Id                 int64                          `json:"id"`
        Name               string                         `json:"name"`
        Type               string                         `json:"type"`
        Category           string                         `json:"category"`
        Tag                string                         `json:"tag"`
        Content            string                         `json:"content"`
        VariableGroupSchema []*TemplateVariableGroupEntity `json:"variable_group_schema"`
        Status             string                         `json:"status"`
        Description        string                         `json:"description"`
        CreatedAt          string                         `json:"created_at"`
        UpdatedAt          string                         `json:"updated_at"`
    }

    BaseTemplatePageEntity {
        Id          int64  `json:"id"`
        Name        string `json:"name"`
        Type        string `json:"type"`
        Category    string `json:"category"`
        Tag         string `json:"tag"`
        Status      string `json:"status"`
        Description string `json:"description"`
        CreatedAt   string `json:"created_at"`
        UpdatedAt   string `json:"updated_at"`
    }
)

// Page
type (
    BaseTemplateFilter {
        Keyword string `json:"keyword,optional"`
        Type     string `json:"type,optional" validate:"omitempty,oneof=Borrower Lender"`
        Category string `json:"category,optional" validate:"omitempty,oneof=Email Contract"`
        Status   string `json:"status,optional" validate:"omitempty,oneof=Active Disabled"`
    }

    BaseTemplatePageRequest {
        BasePageRequest
        Filter *BaseTemplateFilter `json:"filter,optional"`
        Sort   *BasePageSort        `json:"sort,optional"`
    }

    BaseTemplatePageResponse {
        BasePageResponse
        List []*BaseTemplatePageEntity `json:"list"`
    }
)

// Create
type (
    CreateBaseTemplateRequest {
        Name                string                       `json:"name" validate:"required,min=1,max=100"`
        Type                string                       `json:"type" validate:"required,oneof=Borrower Lender"`
        Category            string                       `json:"category" validate:"required,oneof=Email Contract"`
        Tag                 string                       `json:"tag" validate:"required,min=1,max=100"`
        Content             string                       `json:"content" validate:"required,max=10485760"`
        VariableGroupSchema []*TemplateVariableGroupEntity `json:"variable_group_schema" validate:"required"`
        Description         string                       `json:"description" validate:"max=255"`
    }

    CreateBaseTemplateResponse {
        BaseTemplateEntity
    }
)

// Update
type (
    UpdateBaseTemplateRequest {
        Id                  int64                        `path:"id" validate:"required,min=1"`
        Name                string                       `json:"name" validate:"required,min=1,max=100"`
        Type                string                       `json:"type" validate:"required,oneof=Borrower Lender"`
        Category            string                       `json:"category" validate:"required,oneof=Email Contract"`
        Tag                 string                       `json:"tag" validate:"required,min=1,max=100"`
        Content             string                       `json:"content" validate:"required,max=10485760"`
        VariableGroupSchema []*TemplateVariableGroupEntity `json:"variable_group_schema" validate:"required"`
        Description         string                       `json:"description" validate:"max=255"`
    }

    UpdateBaseTemplateResponse {
        BaseTemplateEntity
    }
)

// Detail
type (
    BaseTemplateDetailRequest {
        Id int64 `path:"id" validate:"required,min=1"`
    }

    BaseTemplateDetailResponse {
        BaseTemplateEntity
    }
)

// Switch Status
type (
    BaseTemplateSwitchStatusRequest {
        Id     int64  `path:"id" validate:"required,min=1"`
        Status string `json:"status" validate:"required,oneof=Active Disabled"`
    }
)

// Delete
type (
    DeleteBaseTemplateRequest {
        Id int64 `path:"id" validate:"required,min=1"`
    }
)

@server(
    prefix: /admin/v1
    group: base_template
    middleware: Authority
)
service Admin {
    @doc "Create base template"
    @handler BaseTemplateCreate
    post /base_template (CreateBaseTemplateRequest) returns (CreateBaseTemplateResponse)

    @doc "Update base template"
    @handler BaseTemplateUpdate
    put /base_template/:id (UpdateBaseTemplateRequest) returns (UpdateBaseTemplateResponse)

    @doc "Get base template detail"
    @handler BaseTemplateDetail
    get /base_template/:id (BaseTemplateDetailRequest) returns (BaseTemplateDetailResponse)

    @doc "Base template page list"
    @handler BaseTemplatePage
    post /base_template/page (BaseTemplatePageRequest) returns (BaseTemplatePageResponse)

    @doc "Switch base template status"
    @handler BaseTemplateSwitchStatus
    put /base_template/:id/status (BaseTemplateSwitchStatusRequest) returns (EmptyResponse)

    @doc "Delete base template"
    @handler BaseTemplateDelete
    delete /base_template/:id (DeleteBaseTemplateRequest) returns (EmptyResponse)
}
