@server (
	desc:       "organization email service"
	version:    v1
	group:      organization_email
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       organization_email
)
service borrower-api {
	@doc "generate auth code url"
	@handler OrganizationEmailGenerateAuthCodeUrl
	get /organization_email/generate_auth_code_url (OrganizationEmailGenerateAuthCodeUrlRequest) returns (OrganizationEmailGenerateAuthCodeUrlResponse)

	@doc "save email"
	@handler OrganizationEmailSaveEmail
	post /organization_email/save_email (OrganizationEmailSaveEmailRequest) returns (EmptyResponse)

	@doc "email authorize"
	@handler OrganizationEmailAuthorize
	post /organization_email/authorize (OrganizationEmailAuthorizeRequest) returns (EmptyResponse)
}

// ============= organization email end =============
// ============= drive start ============
@server (
	desc:       "google drive integration service"
	version:    v1
	group:      drive
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       drive
)
service borrower-api {
	@doc "drive auth status"
	@handler DriveAuthStatus
	get /drive/auth_status (EmptyRequest) returns (DriveIntegrationEntity)

	@doc "drive auth url"
	@handler DriveAuthUrl
	get /drive/auth_url (EmptyRequest) returns (DriveAuthUrlResponse)

	@doc "drive authorize"
	@handler DriveAuthorize
	post /drive/authorize (DriveAuthorizeRequest) returns (DriveIntegrationEntity)

	@doc "list shared drives"
	@handler DriveListDrives
	get /drive/drives (EmptyRequest) returns (DriveListDrivesResponse)

	@doc "update drive selection"
	@handler DriveUpdateSelection
	put /drive/selection (DriveUpdateSelectionRequest) returns (EmptyResponse)

	@doc "update folder name"
	@handler DriveUpdateFolder
	put /drive/folder (DriveUpdateFolderRequest) returns (EmptyResponse)

	@doc "disconnect drive"
	@handler DriveDisconnect
	post /drive/disconnect (EmptyRequest) returns (EmptyResponse)

	@doc "sync transaction documents to drive"
	@handler DriveSyncTransaction
	post /borrower_property_transaction/:id/sync_to_drive (DriveSyncTransactionRequest) returns (DriveSyncTransactionResponse)

	@doc "get latest drive sync job status for a transaction"
	@handler DriveGetSyncTransactionStatus
	get /borrower_property_transaction/:id/sync_to_drive/status (DriveSyncTransactionRequest) returns (DriveSyncTransactionResponse)
}

// ============= drive end =============
// =============== borrower property transaction start ==============
@server (
	desc:       "borrower property transaction service"
	version:    v1
	group:      borrower_property_transaction
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       borrower_property_transaction
)
service borrower-api {
	@doc "create transaction"
	@handler BorrowerPropertyTransactionCreate
	post /borrower_property_transaction (BorrowerPropertyTransactionCreateRequest) returns (BorrowerPropertyTransactionCreateResponse)

	@doc "transaction detail"
	@handler BorrowerPropertyTransactionDetail
	get /borrower_property_transaction/:id (BorrowerPropertyTransactionDetailRequest) returns (BorrowerPropertyTransactionEntity)

	@doc "update transaction"
	@handler BorrowerPropertyTransactionUpdate
	put /borrower_property_transaction/:id (BorrowerPropertyTransactionUpdateRequest) returns (BorrowerPropertyTransactionEntity)

	@doc "delete transaction"
	@handler BorrowerPropertyTransactionDelete
	delete /borrower_property_transaction/:id (BorrowerPropertyTransactionDeleteRequest) returns (EmptyResponse)

	@doc "switch transaction status"
	@handler BorrowerPropertyTransactionSwitchStatus
	patch /borrower_property_transaction/:id/status (BorrowerPropertyTransactionSwitchStatusRequest) returns (EmptyResponse)

	@doc "all transactions for select"
	@handler BorrowerPropertyTransactionAll
	get /borrower_property_transaction/all (EmptyRequest) returns (BorrowerPropertyTransactionAllResponse)

	@doc "update transaction checklist"
	@handler BorrowerPropertyTransactionUpdateChecklist
	patch /borrower_property_transaction/:id/checklist (BorrowerPropertyTransactionChecklistRequest) returns (EmptyResponse)

	@doc "page transactions"
	@handler BorrowerPropertyTransactionPage
	post /borrower_property_transaction/page (BorrowerPropertyTransactionPageRequest) returns (BorrowerPropertyTransactionPageResponse)

	@doc "upload file to document"
	@handler DocumentUploadFile
	post /borrower_property_transaction/:transaction_id/document/:document_id/file (BorrowerPropertyTransactionDocumentUploadFileRequest) returns (DocumentUploadFileResponse)

	@doc "delete document file"
	@handler DocumentDeleteFile
	delete /borrower_property_transaction/:transaction_id/file/:file_id (BorrowerPropertyTransactionDocumentDeleteFileRequest) returns (EmptyResponse)

	@doc "create leaf document"
	@handler DocumentCreate
	post /borrower_property_transaction/:transaction_id/document (DocumentCreateRequest) returns (DocumentCreateResponse)

	@doc "transaction operation stats"
	@handler OperationStats
	get /borrower_property_transaction/:transaction_id/operations/stats (TransactionOperationStatsRequest) returns (TransactionOperationStatsResponse)

	@doc "transaction operation list"
	@handler OperationList
	get /borrower_property_transaction/:transaction_id/operations (TransactionOperationListRequest) returns (TransactionOperationListResponse)
}

// =============== borrower property transaction end ==============
// =============== document start ==============
@server (
	desc:       "document service (read-only)"
	version:    v1
	group:      document
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       document
)
service borrower-api {
	@doc "document files"
	@handler DocumentFiles
	get /document/:id/files (DocumentFilesRequest) returns (DocumentFilesResponse)
}

// =============== document end ==============
// ============== zeitro start ============
@server (
	desc:       "Zeitro API"
	version:    v1
	prefix:     /api/v1
	group:      zeitro
	middleware: AuthMiddleware
	tags:       zertro
)
service borrower-api {
	@doc "Search property listings from Zeitro API"
	@handler zeitroListingSearch
	get /zeitro/listings/search (ZeitroListingSearchRequest) returns (ZeitroListingSearchResponse)
}

// ============== zeitro end =============
