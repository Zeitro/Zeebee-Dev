	desc:       "borrower applicant service"
	version:    v1
	group:      borrower_applicant
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       borrower_applicant
)
service borrower-api {
	@doc "page"
	@handler BorrowerApplicantPage
	post /borrower_applicant/page (BorrowerApplicantPageRequest) returns (BorrowerApplicantPageResponse)

	@doc "all"
	@handler BorrowerApplicantAll
	get /borrower_applicant/all (EmptyRequest) returns (BorrowerApplicantAllResponse)

	@doc "detail"
	@handler BorrowerApplicantDetail
	get /borrower_applicant/:id (PathIdRequest) returns (BorrowerApplicantDetailResponse)

	@doc "create"
	@handler BorrowerApplicantCreate
	post /borrower_applicant (BorrowerApplicantEditRequest) returns (BorrowerApplicantCreateResponse)

	@doc "update"
	@handler BorrowerApplicantUpdate
	put /borrower_applicant/:id (BorrowerApplicantEditRequest) returns (EmptyResponse)

	@doc "delete"
	@handler BorrowerApplicantDelete
	delete /borrower_applicant/:id (PathIdRequest) returns (EmptyResponse)

	@doc "existed"
	@handler BorrowerApplicantCheckExisted
