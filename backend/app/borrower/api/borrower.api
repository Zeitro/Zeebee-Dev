@server (
	desc:       "loan document service"
	version:    v1
	group:      loan_document
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       loan_document
)
service borrower-api {
	@doc "add files"
	@handler AddFiles
	post /loan_document/:id/files (LoanDocumentAddFilesRequest) returns (EmptyResponse)
}

// ============== loan document end =============
