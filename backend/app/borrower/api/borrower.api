	desc:       "organization service"
	version:    v1
	group:      organization
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       organization
)
service borrower-api {
	@doc "profile"
	@handler OrganizationProfile
	get /organization/profile (EmptyRequest) returns (OrganizationEntity)

	@doc "lenders"
	@handler OrganizationLenders
	get /organization/lenders (EmptyRequest) returns (OrganizationLendersResponse)

	@doc "lender page"
	@handler OrganizationLenderPage
	post /organization/lender/page (OrganizationLenderPageRequest) returns (OrganizationLenderPageResponse)
}

// ============= organization end =============
