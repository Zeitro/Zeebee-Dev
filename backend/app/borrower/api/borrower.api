syntax = "v1"

info (
	title:  "borrower-api http service"
	desc:   "borrower-api http service description"
	author: "Wei Zeng"
	email:  "wei@yeelee-capital.com"
)

import "desc/user.api"
import "desc/borrower_property_transaction.api"
import "desc/document.api"
import "desc/loan.api"
import "desc/common.api"
import "desc/borrower_property.api"
import "desc/loan_applicant.api"
import "desc/us_geography.api"
import "desc/pdf.api"
import "desc/storage.api"
import "desc/loan_document.api"
import "desc/borrower_entity.api"
import "desc/borrower_applicant.api"
import "desc/role.api"
import "desc/organization_user.api"
import "desc/organization.api"
import "desc/organization_email.api"
import "desc/drive.api"
import "desc/zeitro.api"
import "desc/resource.api"

type (
	EmptyRequest  {}
	EmptyResponse  {}
)

type PathIdRequest {
	id int64 `path:"id" validate:"required,gt=0"`
}

// ============== common start =============
@server (
	desc:       "borrower-api service"
	version:    v1
	group:      common
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       common
)
service borrower-api {
	@doc "select options"
	@handler SelectOptions
	get /select_options (GetSelectOptionRequest) returns (GetSelectOptionResponse)

	@doc "get us states"
	@handler GetUsStates
	get /us_states (EmptyRequest) returns (GetUsStatesResponse)

	@doc "get us city"
	@handler GetUsCities
	get /us_cities (GetUsCitiesRequest) returns (GetUsCitiesResponse)

	@doc "get uuid"
	@handler GetUuid
	get /uuid (EmptyRequest) returns (GetUuidResponse)

	@doc "sync api"
	@handler SyncApi
	get /common/sync_api (EmptyRequest) returns (EmptyResponse)

	@doc "sync resource"
	@handler SyncResource
	get /common/sync_resource (EmptyRequest) returns (EmptyResponse)
}

// ============== common end =============
// ============== user start =============
@server (
	desc:       "borrower-api service"
	version:    v1
	group:      user
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       user
)
service borrower-api {
	@doc "register"
	@handler Register
	post /user/register (UserRegisterRequest) returns (UserRegisterResponse)

	@doc "login"
	@handler Login
	post /user/login (UserLoginRequest) returns (UserLoginResponse)

	@doc "refresh"
	@handler RefreshToken
	post /user/refresh (UserRefreshTokenRequest) returns (UserRefreshTokenResponse)

	@doc "verify email"
	@handler VerifyEmail
	post /user/verify_email (UserVerifyEmailRequest) returns (UserLoginResponse)

	@doc "send verify email"
	@handler SendVerifyEmail
	post /user/send_verify_email (UserSendVerifyEmailRequest) returns (EmptyResponse)

	@doc "reset password"
	@handler ResetPassword
	post /user/reset_password (UserResetPasswordRequest) returns (UserLoginResponse)

	@doc "send reset password email"
	@handler SendResetPassword
	post /user/send_reset_password (UserSendResetPasswordEmailRequest) returns (EmptyResponse)
}

@server (
	desc:       "borrower-api service"
	version:    v1
	group:      user
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       user
)
service borrower-api {
	@doc "info"
	@handler Info
	get /user/info (EmptyRequest) returns (UserInfoResponse)

	@doc "edit profile"
	@handler EditProfile
	put /user/profile (UserEditProfileRequest) returns (UserInfoResponse)

	@doc "switch organization"
	@handler SwitchOrganization
	post /user/switch_organization (UserSwitchOrganizationRequest) returns (UserLoginResponse)

	@doc "change password"
	@handler ChangePassword
	post /user/change_password (UserChangePasswordRequest) returns (EmptyResponse)

	@doc "user menu"
	@handler UserMenu
	get /user/menu (EmptyRequest) returns (ResourceTreeResponse)
}

// ============== user end =============
// ============== loan start =============
@server (
	desc:       "loan service"
	version:    v1
	group:      loan
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       loan
)
service borrower-api {
	@doc "preapproval"
	@handler PreApproval
	post /loan/pre_approval (LoanPreApprovalRequest) returns (LoanPreApprovalResponse)

	@doc "send pre approval loan nofification"
	@handler SendPreApprovalLoanNotification
	post /loan/send_pre_approval_loan_notification (SendPreApprovalLoanNotificationRequest) returns (EmptyResponse)
}

@server (
	desc:       "loan service"
	version:    v1
	group:      loan
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       loan
)
service borrower-api {
	@doc "create"
	@handler Create
	post /loan (LoanCreateRequest) returns (LoanCreateResponse)

	@doc "update"
	@handler Update
	put /loan/:id (LoanUpdateRequest) returns (EmptyResponse)

	@doc "update pending status"
	@handler UpdatePendingStatus
	patch /loan/:id/pending_status (LoanUpdatePendingStatusRequest) returns (EmptyResponse)

	@doc "update stage"
	@handler UpdateStage
	patch /loan/:id/stage (LoanUpdatePendingRequest) returns (EmptyResponse)

	@doc "delete"
	@handler DeleteLoan
	delete /loan/:id (LoanDeleteRequest) returns (EmptyResponse)

	@doc "lender companies list"
	@handler LenderCompanies
	get /loan/lender_companies (EmptyRequest) returns (LoanLenderCompanyResponse)

	@doc "detail"
	@handler Detail
	get /loan/:id (LoanDetailRequest) returns (LoanDetailResponse)

	@doc "page"
	@handler Page
	post /loan/page (LoanPageRequest) returns (LoanPageResponse)

	@doc "apply"
	@handler Apply
	post /loan/apply (LoanApplyRequest) returns (LoanApplyResponse)

	@doc "create draft"
	@handler CreateDraft
	post /loan/draft (LoanApplyRequest) returns (LoanApplyResponse)

	@doc "update draft"
	@handler UpdateDraft
	put /loan/:id/draft (LoanApplyRequest) returns (LoanApplyResponse)

	@doc "update apply"
	@handler UpdateApply
	put /loan/:id/update_apply (LoanApplyRequest) returns (EmptyResponse)

	@doc "import"
	@handler Import
	post /loan/import (ImportLoanRequest) returns (ImportLoanResponse)

	@doc "download import template"
	@handler DownloadImportTemplate
	get /loan/import/template (EmptyRequest) returns (EmptyResponse)

	@doc "send quote email"
	@handler SendQuoteEmail
	post /loan/send_quote_email (LoanSendQuoteEmailRequest) returns (EmptyResponse)

	@doc "dashboard"
	@handler dashboard
	post /loan/dashboard (LoanDashboardRequest) returns (LoanDashboardResponse)
}

// ============== loan end =============
// =============== borrower property start ==============
@server (
	desc:       "borrower property service"
	version:    v1
	group:      borrower_property
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       property
)
service borrower-api {
	@doc "page"
	@handler PropertyPage
	post /property/page (PropertyPageRequest) returns (PropertyPageResponse)

	@doc "all"
	@handler PropertyAll
	get /property/all (EmptyRequest) returns (PropertyAllResponse)

	@doc "property Summary"
	@handler PropertyDetailSummary
	get /property/:id/summary (PropertyDetailRequest) returns (PropertyDetailSummaryResponse)

	@doc "transactions"
	@handler PropertyBorrowerPropertyTransactions
	get /property/:id/borrower_property_transactions (BorrowerPropertyTransactionListByPropertyRequest) returns (BorrowerPropertyTransactionListByPropertyResponse)

	@doc "detail"
	@handler PropertyDetail
	get /property/:id (PathIdRequest) returns (PropertyDetailResponse)

	@doc "create"
	@handler PropertyCreate
	post /property (PropertyCreateRequest) returns (PropertyCreateResponse)

	@doc "update"
	@handler PropertyUpdate
	put /property/:id (PropertyUpdateRequest) returns (EmptyResponse)

	@doc "delete"
	@handler PropertyDelete
	delete /property/:id (PathIdRequest) returns (EmptyResponse)
}

// =============== borrower property end ==============
// =============== borrower entity start ==============
@server (
	desc:       "borrower entity service"
	version:    v1
	group:      borrower_entity
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       borrower_entity
)
service borrower-api {
	@doc "page"
	@handler BorrowerEntityPage
	post /borrower_entity/page (BorrowerEntityPageRequest) returns (BorrowerEntityPageResponse)

	@doc "all"
	@handler BorrowerEntityAll
	get /borrower_entity/all (EmptyRequest) returns (BorrowerEntityAllResponse)

	@doc "existed"
	@handler BorrowerEntityCheckExisted
	get /borrower_entity/check_existed (BorrowerEntityCheckExistedRequest) returns (BorrowerEntityCheckExistedResponse)

	@doc "detail"
	@handler BorrowerEntityDetail
	get /borrower_entity/:id (PathIdRequest) returns (BorrowerEntityDetailResponse)

	@doc "create"
	@handler BorrowerEntityCreate
	post /borrower_entity (BorrowerEntityCreateRequest) returns (BorrowerEntityCreateResponse)

	@doc "update"
	@handler BorrowerEntityUpdate
	put /borrower_entity/:id (BorrowerEntityUpdateRequest) returns (EmptyResponse)

	@doc "delete"
	@handler BorrowerEntityDelete
	delete /borrower_entity/:id (PathIdRequest) returns (EmptyResponse)
}

// =============== borrower entity end ==============
