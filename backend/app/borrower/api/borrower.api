syntax = "v1"

info (
	title:  "borrower-api http service"
	desc:   "borrower-api http service description"
	author: "Wei Zeng"
	email:  "wei@yeelee-capital.com"
)

import "desc/user.api"

type (
	EmptyRequest  {}
	EmptyResponse  {}
)

@server (
	desc:    "borrower-api service"
	version: v1
	group:   user
	prefix:  /api/user
	tags:    user
)
service borrower-api {
	@doc "register"
	@handler Register
	post /register (UserRegisterRequest) returns (UserRegisterResponse)

	@doc "login"
	@handler Login
	post /login (UserLoginRequest) returns (UserLoginResponse)

	@doc "refresh"
	@handler RefreshToken
	post /refresh (UserRefreshTokenRequest) returns (UserRefreshTokenResponse)
}

@server (
	desc:       "borrower-api service"
	version:    v1
	group:      user
	prefix:     /api/user
	middleware: AuthMiddleware
	tags:       user
)
service borrower-api {
	@doc "user info"
	@handler Info
	get /info (EmptyRequest) returns (UserInfoResponse)
}

