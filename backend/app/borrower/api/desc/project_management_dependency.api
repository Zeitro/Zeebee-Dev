syntax = "v1"

info(
    title: "borrower-project-management-dependency-api"
    desc: "borrower project management task dependency types"
    version: "v1"
)

import "../../../../domains/zeebee/api/project_management_entity.api"

type (
    ProjectManagementDependencyPageRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        Page int64 `json:"page,default=1"`
        Limit int64 `json:"limit,default=20"`
        Predecessor bool `json:"predecessor,optional"`
    }

    ProjectManagementDependencyPageResponse {
        Page int64 `json:"page"`
        Limit int64 `json:"limit"`
        Total int64 `json:"total"`
        TotalPage int64 `json:"total_page"`
        List []*ProjectManagementTaskDependencyEntity `json:"list"`
    }

    ProjectManagementDependencyCreateRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        DependencyTaskId int64 `json:"dependency_task_id" validate:"required,gt=0"`
        DependencyType string `json:"dependency_type" validate:"required,oneof=PreTask PostTask"`
        DependencyRule string `json:"dependency_rule" validate:"required,oneof=FS FF SS SF"`
    }

    ProjectManagementDependencyUpdateRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        DependencyId int64 `path:"dependency_id" validate:"required,gt=0"`
        DependencyType string `json:"dependency_type" validate:"required,oneof=PreTask PostTask"`
        DependencyRule string `json:"dependency_rule" validate:"required,oneof=FS FF SS SF"`
    }

    ProjectManagementDependencyDeleteRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        DependencyId int64 `path:"dependency_id" validate:"required,gt=0"`
    }

    ProjectManagementTaskTransitionRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        TargetStageId int64 `json:"target_stage_id" validate:"required,gt=0"`
    }
)

@server (
    desc: "borrower project management"
    version: v1
    group: project_management
    prefix: /api/v1
    middleware: AuthMiddleware
    tags: project_management
)
service borrower-api {
    @doc "page task dependencies"
    @handler ProjectManagementDependencyPage
    post /project_management/task/:id/dependency/page (ProjectManagementDependencyPageRequest) returns (ProjectManagementDependencyPageResponse)

    @doc "create task dependency"
    @handler ProjectManagementDependencyCreate
    post /project_management/task/:id/dependency (ProjectManagementDependencyCreateRequest) returns (ProjectManagementTaskDependencyEntity)

    @doc "update task dependency"
    @handler ProjectManagementDependencyUpdate
    put /project_management/task/:id/dependency/:dependency_id (ProjectManagementDependencyUpdateRequest) returns (ProjectManagementTaskDependencyEntity)

    @doc "delete task dependency"
    @handler ProjectManagementDependencyDelete
    delete /project_management/task/:id/dependency/:dependency_id (ProjectManagementDependencyDeleteRequest) returns (EmptyResponse)

    @doc "transition task"
    @handler ProjectManagementTaskTransition
    post /project_management/task/:id/transition (ProjectManagementTaskTransitionRequest) returns (ProjectManagementTaskEntity)
}
