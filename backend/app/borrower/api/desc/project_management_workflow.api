syntax = "v1"

info (
    title: "borrower-project-management-workflow-api"
    desc: "borrower project management workflow types"
    version: "v1"
    useDefinitions: true
    wrapCodeMsg: true
)

import "../../../../domains/zeebee/api/entity.api"

import "base.api"

import "project_management.api"

type (
    // all request
    ProjectManagementWorkflowAllRequest {
        EntityType string `form:"entity_type" validate:"required,oneof=Organization Project Template"`
        EntityId   int64  `form:"entity_id,optional" validate:"gte=0"`
    }
    ProjectManagementWorkflowAllResponse {
        List []*ProjectManagementWorkflowEntity `json:"list"`
    }
)

type ProjectManagementWorkflowDetailResponse {
    ProjectManagementWorkflowEntity
}

type ProjectManagementWorkflowStageInput {
    Id          int64  `json:"id"`
    Name        string `json:"name" validate:"required,max=100"`
    Description string `json:"description,optional" validate:"max=100"`
    Phase       string `json:"phase" validate:"required,oneof=Pending InProgress Finished"`
    Color       string `json:"color,optional" validate:"max=32"`
    SortOrder   int    `json:"sort_order"`
}

type ProjectManagementWorkflowTransitionInput {
    Id                int64    `json:"id"`
    Name              string   `json:"name" validate:"required,max=100"`
    FromStageId       int64    `json:"from_stage_id" validate:"required,gt=0"`
    ToStageId         int64    `json:"to_stage_id" validate:"required,gt=0"`
    AllowedActorTypes []string `json:"allowed_actor_types,optional"`
}

type ProjectManagementWorkflowCreateRequest {
    Name        string `json:"name" validate:"required,max=100"`
    Description string `json:"description,optional" validate:"max=500"`
    EntityType string `json:"entity_type" validate:"required,oneof=Organization Project"`
    EntityId   int64  `json:"entity_id,optional" validate:"gte=0"`
}

type ProjectManagementWorkflowUpdateRequest {
    Id          int64                                   `path:"id" validate:"required,gt=0"`
    Name        string                                  `json:"name" validate:"required,max=100"`
    Description string                                  `json:"description,optional" validate:"max=500"`
    Stages      []*ProjectManagementWorkflowUpdateStage `json:"stages" validate:"required,min=1,dive"`
}

type ProjectManagementProjectWorkflowPageFilter {
    ProjectId int64 `json:"project_id" validate:"required,gt=0"`
}

type ProjectManagementProjectWorkflowPageRequest {
    Page   int64                                       `json:"page,default=1"`
    Limit  int64                                       `json:"limit,default=20"`
    Filter ProjectManagementProjectWorkflowPageFilter `json:"filter" validate:"required"`
}

type ProjectManagementProjectWorkflowBatchRequest {
    ProjectId          int64   `path:"project_id" validate:"required,gt=0"`
    SourceWorkflowIds  []int64 `json:"source_workflow_ids" validate:"required,min=1,dive,gt=0"`
}

type ProjectManagementProjectWorkflowCreateRequest {
    ProjectId   int64  `path:"project_id" validate:"required,gt=0"`
    Name        string `json:"name" validate:"required,max=100"`
    Description string `json:"description,optional" validate:"max=500"`
}

type ProjectManagementProjectWorkflowUpdateRequest {
    ProjectId   int64                                       `path:"project_id" validate:"required,gt=0"`
    WorkflowId  int64                                       `path:"workflow_id" validate:"required,gt=0"`
    Transitions []*ProjectManagementWorkflowTransitionInput `json:"transitions" validate:"required,min=1,dive"`
}

type ProjectManagementProjectWorkflowDetailRequest {
    ProjectId  int64 `path:"project_id" validate:"required,gt=0"`
    WorkflowId int64 `path:"workflow_id" validate:"required,gt=0"`
}

type ProjectManagementProjectWorkflowDeleteRequest {
    ProjectId  int64 `path:"project_id" validate:"required,gt=0"`
    WorkflowId int64 `path:"workflow_id" validate:"required,gt=0"`
}

type ProjectManagementProjectWorkflowStageUpdateRequest {
    ProjectId  int64                                   `path:"project_id" validate:"required,gt=0"`
    WorkflowId int64                                   `path:"workflow_id" validate:"required,gt=0"`
    Stages     []*ProjectManagementWorkflowUpdateStage `json:"stages" validate:"required,min=1,dive"`
}

type ProjectManagementProjectWorkflowDefaultRequest {
    ProjectId  int64 `path:"project_id" validate:"required,gt=0"`
    WorkflowId int64 `path:"workflow_id" validate:"required,gt=0"`
}

type ProjectManagementWorkflowPageResponse {
    Total     int64                           `json:"total"`
    Page      int64                           `json:"page"`
    Limit     int64                           `json:"limit"`
    TotalPage int64                           `json:"total_page"`
    List      []*ProjectManagementWorkflowEntity `json:"list"`
}

type ProjectManagementWorkflowBatchResponse {
    List []*ProjectManagementWorkflowEntity `json:"list"`
}

type ProjectManagementWorkflowTemplateResponse {
    List []*ProjectManagementTemplateEntity `json:"list"`
}

type ProjectManagementWorkflowTemplateRequest {}

@server (
    desc: "borrower project management workflow"
    version: v1
    group: project_management_workflow
    prefix: /api/v1
    middleware: AuthMiddleware
    tags: project_management_workflow
)
service borrower-api {
    @doc "all"
    @handler All
    get /project_management/workflow/all (ProjectManagementWorkflowAllRequest) returns (ProjectManagementWorkflowAllResponse)

    @doc "set default workflow"
    @handler Default
    put /project_management/workflow/:id/default (PathIdRequest) returns (EmptyResponse)

    @doc "detail"
    @handler Detail
    get /project_management/workflow/:id (PathIdRequest) returns (ProjectManagementWorkflowDetailResponse)

    @doc "create"
    @handler Create
    post /project_management/workflow (ProjectManagementWorkflowCreateRequest) returns (ProjectManagementWorkflowDetailResponse)

    @doc "update"
    @handler Update
    put /project_management/workflow/:id (ProjectManagementWorkflowUpdateRequest) returns (ProjectManagementWorkflowDetailResponse)

    @doc "delete"
    @handler Delete
    delete /project_management/workflow/:id (PathIdRequest) returns (EmptyResponse)

    @doc "project workflow page"
    @handler ProjectManagementProjectWorkflowPage
    post /project_management/project/workflows/page (ProjectManagementProjectWorkflowPageRequest) returns (ProjectManagementWorkflowPageResponse)

    @doc "copy workflows into project"
    @handler ProjectManagementProjectWorkflowBatch
    post /project_management/project/:project_id/workflows/batch (ProjectManagementProjectWorkflowBatchRequest) returns (ProjectManagementWorkflowBatchResponse)

    @doc "create project workflow from project stages"
    @handler ProjectManagementProjectWorkflowCreate
    post /project_management/project/:project_id/workflows (ProjectManagementProjectWorkflowCreateRequest) returns (ProjectManagementWorkflowDetailResponse)

    @doc "project workflow detail"
    @handler ProjectManagementProjectWorkflowDetail
    get /project_management/project/:project_id/workflows/:workflow_id (ProjectManagementProjectWorkflowDetailRequest) returns (ProjectManagementWorkflowDetailResponse)

    @doc "delete project workflow"
    @handler ProjectManagementProjectWorkflowDelete
    delete /project_management/project/:project_id/workflows/:workflow_id (ProjectManagementProjectWorkflowDeleteRequest) returns (EmptyResponse)

    @doc "update project workflow transitions"
    @handler ProjectManagementProjectWorkflowUpdate
    put /project_management/project/:project_id/workflows/:workflow_id (ProjectManagementProjectWorkflowUpdateRequest) returns (ProjectManagementWorkflowDetailResponse)

    @doc "update project workflow stages"
    @handler ProjectManagementProjectWorkflowStageUpdate
    put /project_management/project/:project_id/workflows/:workflow_id/stages (ProjectManagementProjectWorkflowStageUpdateRequest) returns (ProjectManagementWorkflowDetailResponse)

    @doc "set project workflow default"
    @handler ProjectManagementProjectWorkflowDefault
    put /project_management/project/:project_id/workflows/:workflow_id/default (ProjectManagementProjectWorkflowDefaultRequest) returns (EmptyResponse)

    @doc "discover project templates"
    @handler ProjectManagementProjectWorkflowTemplate
    get /project_management/project/templates (ProjectManagementWorkflowTemplateRequest) returns (ProjectManagementWorkflowTemplateResponse)
}
