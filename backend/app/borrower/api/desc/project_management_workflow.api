syntax = "v1"

info (
    title: "borrower-project-management-workflow-api"
    desc: "borrower project management workflow types"
    version: "v1"
)

import "../../../../domains/zeebee/api/project_management_entity.api"

import "base.api"

type (
    ProjectManagementWorkflowAllRequest {}
    ProjectManagementWorkflowAllResponse {
        Lists []*ProjectManagementWorkflowEntity `json:"lists"`
    }
    ProjectManagementWorkflowDetailResponse {
        ProjectManagementWorkflowEntity
    }
    ProjectManagementWorkflowCreateRequest {
        Name        string `json:"name" validate:"required,max=100"`
        Description string `json:"description,optional" validate:"max=500"`
    }
    ProjectManagementWorkflowUpdateRequest {
        Id          int64  `path:"id" validate:"required,gt=0"`
        Name        string `json:"name" validate:"required,max=100"`
        Description string `json:"description,optional" validate:"max=500"`
    }

)

@server (
    desc: "borrower project management workflow"
    version: v1
    group: project_management_workflow
    prefix: /api/v1
    middleware: AuthMiddleware
    tags: project_management_workflow
)
service borrower-api {
    @doc "all"
    @handler All
    get /project_management/workflow/all (ProjectManagementWorkflowAllRequest) returns (ProjectManagementWorkflowAllResponse)

    @doc "set default workflow"
    @handler Default
    put /project_management/workflow/:id/default (PathIdRequest) returns (EmptyResponse)

    @doc "detail"
    @handler Detail
    get /project_management/workflow/:id (PathIdRequest) returns (ProjectManagementWorkflowDetailResponse)

    @doc "create"
    @handler Create
    post /project_management/workflow (ProjectManagementWorkflowCreateRequest) returns (ProjectManagementWorkflowDetailResponse)

    @doc "update"
    @handler Update
    put /project_management/workflow/:id (ProjectManagementWorkflowUpdateRequest) returns (ProjectManagementWorkflowDetailResponse)

    @doc "delete"
    @handler Delete
    delete /project_management/workflow/:id (PathIdRequest) returns (EmptyResponse)

}
