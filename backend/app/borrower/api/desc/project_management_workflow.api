syntax = "v1"

info(
    title: "borrower-project-management-workflow-api"
    desc: "borrower project management workflow types"
    version: "v1"
)

import "../../../../domains/zeebee/api/project_management_entity.api"

type (
    ProjectManagementWorkflowAllResponse {
        Data []*ProjectManagementWorkflowEntity `json:"data"`
    }

    ProjectManagementWorkflowPageFilter {
        Keyword string `json:"keyword,optional"`
        Enabled *bool `json:"enabled,optional"`
    }

    ProjectManagementWorkflowPageRequest {
        Page int64 `json:"page,default=1"`
        Limit int64 `json:"limit,default=20"`
        Filter ProjectManagementWorkflowPageFilter `json:"filter,optional"`
    }

    ProjectManagementWorkflowPageResponse {
        Page int64 `json:"page"`
        Limit int64 `json:"limit"`
        Total int64 `json:"total"`
        TotalPage int64 `json:"total_page"`
        List []*ProjectManagementWorkflowPageEntity `json:"list"`
    }

    ProjectManagementWorkflowDetailRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
    }

    ProjectManagementWorkflowCreateRequest {
        Name string `json:"name" validate:"required,max=100"`
        Description string `json:"description,optional" validate:"max=500"`
        Enabled bool `json:"enabled"`
        IsDefault bool `json:"is_default"`
        Stages []*ProjectManagementWorkflowStageEntity `json:"stages" validate:"required,min=1,dive"`
        Transitions []*ProjectManagementWorkflowTransitionEntity `json:"transitions,optional" validate:"dive"`
    }

    ProjectManagementWorkflowUpdateRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        Name string `json:"name" validate:"required,max=100"`
        Description string `json:"description,optional" validate:"max=500"`
        Enabled bool `json:"enabled"`
        IsDefault bool `json:"is_default"`
        Stages []*ProjectManagementWorkflowStageEntity `json:"stages" validate:"required,min=1,dive"`
        Transitions []*ProjectManagementWorkflowTransitionEntity `json:"transitions,optional" validate:"dive"`
    }

    ProjectManagementWorkflowDeleteRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
    }
)
