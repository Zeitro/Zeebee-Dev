syntax = "v1"

info(
    title: "borrower-applicant-api"
    desc: "borrower-applicant-api http service description"
    version: "v1"
)

import "address.api"

type BorrowerApplicantEntry {
    Id int64 `json:"id"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    BorrowerId int64 `json:"borrower_id"`
    FirstName string `json:"first_name"`
    MidName string `json:"mid_name"`
    LastName string `json:"last_name"`
    FullName string `json:"full_name"`
    Ssn string `json:"ssn"`
    Dob string `json:"dob"`
    MaritalStatus string `json:"marital_status"`
    Email string `json:"email"`
    Phone string `json:"phone"`
    EstCreditScore int32 `json:"est_credit_score"`
    DriverLicenseNum string `json:"driver_license_num"`
    Address AddressEntry `json:"address"`
}

type BorrowerApplicantPageEntry {
    Id int64 `json:"id"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    FirstName string `json:"first_name"`
    MidName string `json:"mid_name"`
    LastName string `json:"last_name"`
    FullName string `json:"full_name"`
    Ssn string `json:"ssn"`
    Dob string `json:"dob"`
    MaritalStatus string `json:"marital_status"`
    Email string `json:"email"`
    Phone string `json:"phone"`
    EstCreditScore int32 `json:"est_credit_score"`
    DriverLicenseNum string `json:"driver_license_num"`
    Address AddressEntry `json:"address"`
}


// page
type (
    BorrowerApplicantPageFilter {
        Keyword string `json:"keyword,optional"`
    }

    BorrowerApplicantPageSorter {
        Column string `json:"column,optional"`
        Sort string `json:"sort,optional"`
    }
    BorrowerApplicantPageRequest {
        Page int64 `json:"page,optional"`
        Limit int64 `json:"limit,optional"`
        Filter BorrowerApplicantPageFilter `json:"filter,optional"`
        Sorter BorrowerApplicantPageSorter `json:"sorter,optional"`
    }

    BorrowerApplicantPageResponse {
        Page int64 `json:"page"`
        Limit int64 `json:"limit"`
        Total int64 `json:"total"`
        TotalPage int64 `json:"total_page"`
        List []BorrowerApplicantPageEntry `json:"list"`
    }
)
// check is existed
type (
    BorrowerApplicantCkeckExistedRequest {
        Id int64 `form:"id,optional"`
        FirstName string `form:"first_name"`
        LastName string `form:"last_name"`
        MidName string `form:"mid_name, optional"`
    }

    BorrowerApplicantCkeckExistedResponse {
        IsExisted bool `json:"is_existed"`
    }
)

// edit
type (
    BorrowerApplicantEditRequest {
        Id int64 `path:"id,optional"`
        FirstName string `json:"first_name" validate:"required,min=2,max=100"`
        MidName string `json:"mid_name,optional"`
        LastName string `json:"last_name" validate:"required,min=2,max=100"`
        Ssn string `json:"ssn" validate:"required,min=9,max=9"`
        Dob string `json:"dob" validate:"required,datetime=01/02/2006"`
        MaritalStatus string `json:"marital_status" validate:"required,oneof=Married Unmarried Separated"`
        Email string `json:"email" validate:"required,email"`
        Phone string `json:"phone" validate:"required,min=8,max=15"`
        EstCreditScore int32 `json:"est_credit_score" validate:"required,min=300,max=850"`
        DriverLicenseNum string `json:"driver_license_num" validate:"required,min=5,max=30"`
        Address *AddressEntry `json:"address" validate:"required"`
    }

    BorrowerApplicantCreateResponse {
        BorrowerApplicantEntry
    }
)

// detail
type (
    BorrowerApplicantDetailResponse {
        BorrowerApplicantEntry
    }
)
// all
type (
    BorrowerApplicantAllResponse {
        Lists []*BorrowerApplicantPageEntry `json:"lists"`
    }
)