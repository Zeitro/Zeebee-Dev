syntax = "v1"

info(
    title: "borrower-user-api"
    desc: "user-api http service description"
    author: "Wei Zeng"
    email: "wei@yeelee-capital.com"
    version: "v1"
)

type UserInfo {
    Id int64 `json:"id"`
    Email string `json:"email"`
    FirstName string `json:"first_name"`
    LastName string `json:"last_name"`
    FullName string `json:"full_name"`
    Status string `json:"status"`
}
// login
type (
    UserLoginRequest {
        Email string `json:"email" validate:"required,email"`
        Password string `json:"password" validate:"required,min=8,max=32"`
    }

    UserLoginResponse {
        AccessToken string `json:"access_token"`
        AccessTokenExpire int64 `json:"access_token_expire"`
        RefreshToken string `json:"refresh_token"`
        RefreshTokenExpire int64 `json:"refresh_token_expire"`
    }
)
// register
type (
    UserRegisterRequest {
        Email string `json:"email" validate:"required,email"`
        Password string `json:"password" validate:"required,min=8,max=32,password"`
        ComfiredPassword string `json:"comfired_password" validate:"required,eqfield=Password"`
        FirstName string `json:"first_name" validate:"required,min=2,max=30"`
        LastName string `json:"last_name" validate:"required,min=2,max=30"`
        PreApprovalRequestId string `json:"pre_approval_request_id,optional"`
        TargetLenderCompanyId int64 `json:"target_lender_company_id,optional"`
    }

    UserRegisterResponse {
        //        AccessToken string `json:"access_token"`
        //        AccessTokenExpire int64 `json:"access_token_expire"`
        //        RefreshToken string `json:"refresh_token"`
        //        RefreshTokenExpire int64 `json:"refresh_token_expire"`
    }
)

// refresh token
type (
    UserRefreshTokenRequest {
        RefreshToken string `json:"refresh_token" validate:"required"`
    }
    UserRefreshTokenResponse {
        AccessToken string `json:"access_token"`
        AccessTokenExpire int64 `json:"access_token_expire"`
    }
)

// user info
type (
    UserInfoResponse {
        UserInfo
    }
)

// verify email
type (
    UserVerifyEmailRequest {
        Email string `json:"email" validate:"required,email"`
        Code string `json:"code" validate:"required,len=10"`
    }
)

// send verify email
type (
    UserSendVerifyEmailRequest {
        Email string `json:"email" validate:"required,email"`
    }
)

// reset password
type (
    UserResetPasswordRequest {
        Email string `json:"email" validate:"required,email"`
        Password string `json:"password" validate:"required,min=8,max=32,password"`
        ComfiredPassword string `json:"comfired_password" validate:"required,eqfield=Password"`
        Code string `json:"code" validate:"required,len=10"`
    }
)


// send reset password email
type (
    UserSendResetPasswordEmailRequest {
        Email string `json:"email" validate:"required,email"`
    }
)

