syntax = "v1"

info (
    title: "borrower-project-management-workflow-stage-api"
    desc: "borrower project management workflow stage types"
    version: "v1"
    useDefinitions: true
    wrapCodeMsg: true
)

import "../../../../domains/zeebee/api/project_management_entity.api"
import "base.api"

type (
    ProjectManagementWorkflowStageAllRequest {
        WorkflowId int64 `path:"workflow_id" validate:"required,gt=0"`
    }
    ProjectManagementWorkflowStageAllResponse {
        Lists []*ProjectManagementWorkflowStageEntity `json:"lists"`
    }
    ProjectManagementWorkflowStageDetailResponse {
        ProjectManagementWorkflowStageEntity
    }
    ProjectManagementWorkflowStageDetailRequest {
        WorkflowId int64 `path:"workflow_id" validate:"required,gt=0"`
        Id int64 `path:"id" validate:"required,gt=0"`
    }
    ProjectManagementWorkflowStageCreateRequest {
        WorkflowId int64 `path:"workflow_id" validate:"required,gt=0"`
        Name string `json:"name" validate:"required,max=100"`
        Phase string `json:"phase" validate:"required,oneof=Pending InProgress Finished"`
        Color string `json:"color,optional" validate:"max=32"`
        SortOrder int `json:"sort_order" validate:"gte=0"`
    }
    ProjectManagementWorkflowStageUpdateRequest {
        WorkflowId int64 `path:"workflow_id" validate:"required,gt=0"`
        Id int64 `path:"id" validate:"required,gt=0"`
        Name string `json:"name" validate:"required,max=100"`
        Phase string `json:"phase" validate:"required,oneof=Pending InProgress Finished"`
        Color string `json:"color,optional" validate:"max=32"`
        SortOrder int `json:"sort_order" validate:"gte=0"`
    }
)

@server (
    desc: "borrower project management workflow stage"
    version: v1
    group: project_management_workflow_stage
    prefix: /api/v1
    middleware: AuthMiddleware
    tags: project_management_workflow_stage
)
service borrower-api {
    @doc "all"
    @handler All
    get /project_management/workflow/:workflow_id/stage/all (ProjectManagementWorkflowStageAllRequest) returns (ProjectManagementWorkflowStageAllResponse)

    @doc "create"
    @handler Create
    post /project_management/workflow/:workflow_id/stage (ProjectManagementWorkflowStageCreateRequest) returns (ProjectManagementWorkflowStageDetailResponse)

    @doc "detail"
    @handler Detail
    get /project_management/workflow/:workflow_id/stage/:id (ProjectManagementWorkflowStageDetailRequest) returns (ProjectManagementWorkflowStageDetailResponse)

    @doc "update"
    @handler Update
    put /project_management/workflow/:workflow_id/stage/:id (ProjectManagementWorkflowStageUpdateRequest) returns (ProjectManagementWorkflowStageDetailResponse)

    @doc "delete"
    @handler Delete
    delete /project_management/workflow/:workflow_id/stage/:id (ProjectManagementWorkflowStageDetailRequest) returns (EmptyResponse)
}
