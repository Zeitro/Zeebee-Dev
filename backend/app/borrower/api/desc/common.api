syntax = "v1"

info(
    title: "borrower-common-api"
    desc: "common-api http service description"
    version: "v1"
)

type SelectOptionEntity {
    Label string `json:"label"`
    Value string `json:"value"`
}

type (
    GetSelectOptionRequest  {
        name string `form:"name"`
    }

    GetSelectOptionResponse  {
        Options []SelectOptionEntity `json:"options"`
    }
)