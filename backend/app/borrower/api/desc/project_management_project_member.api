syntax = "v1"

info (
    title: "borrower-project-management-project-member-api"
    desc: "borrower project management project member types"
    version: "v1"
)

import "../../../../domains/zeebee/api/project_management_entity.api"

import "base.api"

type (
    ProjectManagementMemberInput {
        OrganizationUserId int64  `json:"organization_user_id" validate:"required,gt=0"`
        Role               string `json:"role" validate:"required,oneof=ProjectAdmin TaskExecutor"`
    }
    ProjectManagementMemberPageFilter {
        Keyword string `json:"keyword,optional"`
        Role    string `json:"role,optional" validate:"omitempty,oneof=ProjectOwner ProjectAdmin TaskExecutor"`
    }
    ProjectManagementMemberPageRequest {
        ProjectId int64                             `json:"project_id" validate:"required,gt=0"`
        Page      int64                             `json:"page,default=1"`
        Limit     int64                             `json:"limit,default=20"`
        Filter    ProjectManagementMemberPageFilter `json:"filter,optional"`
    }
    ProjectManagementMemberPageResponse {
        Page      int64                            `json:"page"`
        Limit     int64                            `json:"limit"`
        Total     int64                            `json:"total"`
        TotalPage int64                            `json:"total_page"`
        List      []*ProjectManagementMemberEntity `json:"list"`
    }
    ProjectManagementMemberCandidateRequest {
        ProjectId int64  `form:"project_id" validate:"required,gt=0"`
        Keyword   string `form:"keyword,optional"`
        NeedAll   bool   `form:"need_all,optional"`
    }
    ProjectManagementMemberCandidateResponse {
        Lists []*ProjectManagementMemberEntity `json:"lists"`
    }
    ProjectManagementMemberAddRequest {
        ProjectId int64                           `json:"project_id" validate:"required,gt=0"`
        Members   []*ProjectManagementMemberInput `json:"members" validate:"required,min=1,dive"`
    }
    ProjectManagementMemberUpdateRequest {
        Id        int64  `path:"id" validate:"required,gt=0"`
        ProjectId int64  `json:"project_id" validate:"required,gt=0"`
        //        UserId                int64  `path:"user_id" validate:"required,gt=0"`
        Role      string `json:"role,optional" validate:"omitempty,oneof=ProjectAdmin TaskExecutor"`
        //        TransferOwnerToUserId int64  `json:"transfer_owner_to_user_id,optional"`
    }
    ProjectManagementMemberDeleteRequest {
        Id        int64 `path:"id" validate:"required,gt=0"`
        ProjectId int64 `json:"project_id" validate:"required,gt=0"`
        //        UserId int64 `path:"user_id" validate:"required,gt=0"`
    }
)

@server (
    desc: "borrower project management project member"
    version: v1
    group: project_management_project_member
    prefix: /api/v1
    middleware: AuthMiddleware
    tags: project_management_project_member
)
service borrower-api {
    @doc "page"
    @handler Page
    post /project_management/project_member/page (ProjectManagementMemberPageRequest) returns (ProjectManagementMemberPageResponse)

    @doc "candidate"
    @handler Candidate
    get /project_management/project_member/candidate (ProjectManagementMemberCandidateRequest) returns (ProjectManagementMemberCandidateResponse)

    @doc "add member"
    @handler Add
    post /project_management/project_member (ProjectManagementMemberAddRequest) returns (EmptyResponse)

    @doc "update"
    @handler Update
    put /project_management/project_member/:id (ProjectManagementMemberUpdateRequest) returns (EmptyResponse)

    @doc "delete"
    @handler Delete
    delete /project_management/project_member/:id (ProjectManagementMemberDeleteRequest) returns (EmptyResponse)
}
