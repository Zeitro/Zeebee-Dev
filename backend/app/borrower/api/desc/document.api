syntax = "v1"

info(
    title: "document-api"
    desc: "document management api"
    version: "v1"
)

// document node types
type (
    DocumentTreeNode {
        Id int64 `json:"id"`
        ParentId int64 `json:"parent_id"`
        Type string `json:"type"`
        Name string `json:"name"`
        Level int32 `json:"level"`
        SortOrder int32 `json:"sort_order"`
        LastUploadedAt string `json:"last_uploaded_at"`
        Metadata map[string]interface{} `json:"metadata"`
        CreatedAt string `json:"created_at"`
        UpdatedAt string `json:"updated_at"`
        Children []DocumentTreeNode `json:"children"`
        Files []DocumentFile `json:"files"`
    }
    DocumentFile {
        Id int64 `json:"id"`
        EntityType string `json:"entity_type"`
        EntityId int64 `json:"entity_id"`
        FileUrl string `json:"file_url"`
        StorageType string `json:"storage_type"`
        FileName string `json:"file_name"`
        ExternalId string `json:"external_id"`
        uploadType string `json:"upload_type"`
        CreatedAt string `json:"created_at"`
        UpdatedAt string `json:"updated_at"`
    }
)





// document files list
type (
    DocumentFilesRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
    }
    DocumentFilesResponse {
        Files []DocumentFile `json:"files"`
    }
)

// create leaf document (nested under transaction route)
type (
    DocumentCreateRequest {
        TransactionId int64 `path:"transaction_id" validate:"required,gt=0"`
        ParentId int64 `json:"parent_id" validate:"required,gt=0"`
        Names []string `json:"names" validate:"required,dive,required,min=1"`
    }
    DocumentCreateResponse {
        List []DocumentTreeNode `json:"list"`
    }
)
