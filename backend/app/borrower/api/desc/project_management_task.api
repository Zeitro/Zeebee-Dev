syntax = "v1"

info (
    title: "borrower-project-management-task-api"
    desc: "borrower project management task types"
    version: "v1"
    useDefinitions: true
    wrapCodeMsg: true
)

import "../../../../domains/zeebee/api/project_management_entity.api"

import "base.api"

type (
    // page filter
    ProjectManagementTaskPageFilter {
        StageId    int64    `json:"stage_id,optional"`
        Phase      []string `json:"phase,optional" validate:"omitempty,dive,oneof=Pending InProgress Finished"`
        Priority   string   `json:"priority,optional" validate:"omitempty,oneof=Low Medium High Critical"`
        TaskTypeId int64    `json:"task_type_id,optional"`
        ProjectId  int64    `json:"project_id"`
        Keyword    string   `json:"keyword,optional"`
        Overdue    *bool    `json:"overdue,optional"`
    }
    // page request
    ProjectManagementTaskPageRequest {
        Page   int64                           `json:"page,default=1"`
        Limit  int64                           `json:"limit,default=20"`
        Filter ProjectManagementTaskPageFilter `json:"filter,optional"`
    }
    // page response
    ProjectManagementTaskPageResponse {
        Page      int64                              `json:"page"`
        Limit     int64                              `json:"limit"`
        Total     int64                              `json:"total"`
        TotalPage int64                              `json:"total_page"`
        List      []*ProjectManagementTaskPageEntity `json:"list"`
    }
    ProjectManagementTaskPageEntity {
        Id             int64                                    `json:"id"`
        ProjectId      int64                                    `json:"project_id"`
        ProjectName    string                                   `json:"project_name"`
        ParentTaskId   int64                                    `json:"parent_task_id"`
        StageId        int64                                    `json:"stage_id"`
        StageName      string                                   `json:"stage_name"`
        Phase          string                                   `json:"phase"`
        CreatorId      int64                                    `json:"creator_id"`
        CreatorName    string                                   `json:"creator_name"`
        Title          string                                   `json:"title"`
        Priority       string                                   `json:"priority"`
        WorkHours      float64                                  `json:"work_hours"`
        StartAt        string                                   `json:"start_at"`
        EndAt          string                                   `json:"end_at"`
        TaskType       *ProjectManagementTaskTypeSnapshotEntity `json:"task_type"`
        Assignees      []*ProjectManagementTaskAssigneeEntity   `json:"assignees"`
        Overdue        bool                                     `json:"overdue"`
        OverdueSeconds int64                                    `json:"overdue_seconds"`
        CreatedAt      string                                   `json:"created_at"`
        UpdatedAt      string                                   `json:"updated_at"`
    }
)

// candidate request
type ProjectManagementTaskCandidateRequest {
    ProjectId int64  `form:"project_id" validate:"required,gt=0"`
    TaskId    int64  `form:"task_id" validate:"required,gt=0"`
    Keyword   string `form:"keyword,optional"`
}

type (
    ProjectManagementTaskCandidateEntity {
        Id    int64  `json:"id"`
        Title string `json:"title"`
        Phase string `json:"phase"`
    }
    // candidate response
    ProjectManagementTaskCandidateResponse {
        List []*ProjectManagementTaskCandidateEntity `json:"list"`
    }
)

// detail response
type ProjectManagementTaskDetailResponse {
    ProjectManagementTaskEntity
}

// attachment detail response
type ProjectManagementAttachmentDetailResponse {
    FileEntity
}

// create request
type ProjectManagementTaskCreateRequest {
    ProjectId                   int64   `json:"project_id" validate:"required,gt=0"`
    ParentTaskId                int64   `json:"parent_task_id,optional" validate:"gte=0"`
    Title                       string  `json:"title" validate:"required,max=255"`
    Description                 string  `json:"description,optional"`
    Priority                    string  `json:"priority" validate:"oneof=Low Medium High Critical"`
    WorkHours                   float64 `json:"work_hours,optional" validate:"gte=0"`
    StartAt                     string  `json:"start_at,optional" validate:"omitempty,datetime=01/02/2006"`
    EndAt                       string  `json:"end_at,optional" validate:"omitempty,datetime=01/02/2006"`
    TaskTypeId                  int64   `json:"task_type_id" validate:"required,gt=0"`
    AssigneeOrganizationUserIds []int64 `json:"assignee_organization_user_ids,optional"`
}

// detail request
type ProjectManagementTaskDetailRequest {
    Id        int64 `path:"id" validate:"required,gt=0"`
    ProjectId int64 `form:"project_id" validate:"required,gt=0"`
}

// task dependency input
type ProjectManagementTaskDependencyRequest {
    Id               int64  `json:"id,optional" validate:"gte=0"`
    TaskId           int64  `json:"task_id" validate:"required,gt=0"`
    DependencyTaskId int64  `json:"dependency_task_id" validate:"required,gt=0"`
    DependencyType   string `json:"dependency_type" validate:"required,oneof=PreTask PostTask"`
    DependencyRule   string `json:"dependency_rule" validate:"required,oneof=FF FS SS SF"`
}

type ProjectManagementTaskAttachmentRequest {
    Id          int64  `json:"id,optional" validate:"gte=0"`
    FileName    string `json:"file_name,optional" validate:"required,max=255"`
    FileUrl     string `json:"file_url,optional" validate:"required,uri,max=255"`
    StorageType string `json:"storage_type,optional" validate:"oneof='Aws S3' GoogleDrive"`
    UploadType  string `json:"upload_type,optional" validate:"oneof=Manual GoogleDrive"`
}

// update request
type ProjectManagementTaskUpdateRequest {
    Id                          int64                                     `path:"id" validate:"required,gt=0"`
    Title                       string                                    `json:"title" validate:"required,max=255"`
    Description                 string                                    `json:"description,optional"`
    Priority                    string                                    `json:"priority,optional" validate:"omitempty,oneof=Low Medium High Critical"`
    WorkHours                   float64                                   `json:"work_hours,optional" validate:"gte=0"`
    StartAt                     string                                    `json:"start_at,optional" validate:"omitempty,datetime=01/02/2006"`
    EndAt                       string                                    `json:"end_at,optional" validate:"omitempty,datetime=01/02/2006"`
    TaskTypeId                  int64                                     `json:"task_type_id,optional"`
    AssigneeOrganizationUserIds []int64                                   `json:"assignee_organization_user_ids,optional"`
    Dependencies                []*ProjectManagementTaskDependencyRequest `json:"dependencies,optional"`
    Attachments                 []*ProjectManagementTaskAttachmentRequest `json:"attachments,optional"`
}

// transition request
type ProjectManagementTaskTransitionRequest {
    Id            int64 `path:"id" validate:"required,gt=0"`
    ProjectId     int64 `json:"project_id" validate:"required,gt=0"`
    TargetStageId int64 `json:"target_stage_id" validate:"required,gt=0"`
}

// delete request
type ProjectManagementTaskDeleteRequest {
    Id        int64 `path:"id" validate:"required,gt=0"`
    ProjectId int64 `form:"project_id" validate:"required,gt=0"`
}

// my task page request
type ProjectManagementMyTaskPageRequest {
    Page   int64                             `json:"page,default=1"`
    Limit  int64                             `json:"limit,default=20"`
    Filter ProjectManagementMyTaskPageFilter `json:"filter,optional"`
}

// my task page filter
type ProjectManagementMyTaskPageFilter {
    ProjectId  int64    `json:"project_id,optional"`
    StageId    int64    `json:"stage_id,optional"`
    Phase      []string `json:"phase,optional" validate:"omitempty,dive,oneof=Pending InProgress Finished"`
    Priority   string   `json:"priority,optional" validate:"omitempty,oneof=Low Medium High Critical"`
    TaskTypeId int64    `json:"task_type_id,optional"`
    Keyword    string   `json:"keyword,optional"`
    Overdue    *bool    `json:"overdue,optional"`
}

// attachment create request
type ProjectManagementAttachmentCreateRequest {
    Id          int64  `path:"id" validate:"required,gt=0"`
    ProjectId   int64  `json:"project_id" validate:"required,gt=0"`
    FileName    string `json:"file_name,optional" validate:"max=255"`
    FileUrl     string `json:"file_url" validate:"required,max=255"`
    StorageType string `json:"storage_type,optional" validate:"max=20"`
    UploadType  string `json:"upload_type,optional" validate:"omitempty,oneof=Manual GoogleDrive"`
}

// attachment delete request
type ProjectManagementAttachmentDeleteRequest {
    Id     int64 `path:"id" validate:"required,gt=0"`
    FileId int64 `path:"file_id" validate:"required,gt=0"`
}

@server (
    desc: "borrower project management task"
    version: v1
    group: project_management_task
    prefix: /api/v1
    middleware: AuthMiddleware
    tags: project_management_task
)
service borrower-api {
    @doc "page"
    @handler Page
    post /project_management/task/page (ProjectManagementTaskPageRequest) returns (ProjectManagementTaskPageResponse)

    @doc "candidate"
    @handler Candidate
    get /project_management/task/candidate (ProjectManagementTaskCandidateRequest) returns (ProjectManagementTaskCandidateResponse)

    @doc "create"
    @handler Create
    post /project_management/task (ProjectManagementTaskCreateRequest) returns (ProjectManagementTaskDetailResponse)

    @doc "detail"
    @handler Detail
    get /project_management/task/:id (ProjectManagementTaskDetailRequest) returns (ProjectManagementTaskDetailResponse)

    @doc "update"
    @handler Update
    put /project_management/task/:id (ProjectManagementTaskUpdateRequest) returns (ProjectManagementTaskDetailResponse)

    @doc "transition"
    @handler Transition
    post /project_management/task/:id/transition (ProjectManagementTaskTransitionRequest) returns (ProjectManagementTaskDetailResponse)

    @doc "delete"
    @handler Delete
    delete /project_management/task/:id (ProjectManagementTaskDeleteRequest) returns (EmptyResponse)

//    @doc "attachment create"
//    @handler AttachmentCreate
//    post /project_management/task/:id/attachment (ProjectManagementAttachmentCreateRequest) returns (ProjectManagementAttachmentDetailResponse)

//    @doc "attachment delete"
//    @handler AttachmentDelete
//    delete /project_management/task/:id/attachment/:file_id (ProjectManagementAttachmentDeleteRequest) returns (EmptyResponse)

    @doc "my task"
    @handler MyTask
    post /project_management/task/my (ProjectManagementMyTaskPageRequest) returns (ProjectManagementTaskPageResponse)
}
