syntax = "v1"

info(
    title: "borrower-project-management-task-api"
    desc: "borrower project management task types"
    version: "v1"
)

import "../../../../domains/zeebee/api/project_management_entity.api"

type (
    ProjectManagementTaskPageFilter {
        StageId int64 `json:"stage_id,optional"`
        TaskTypeId int64 `json:"task_type_id,optional"`
        AssigneeId int64 `json:"assignee_id,optional"`
        Keyword string `json:"keyword,optional"`
        Overdue *bool `json:"overdue,optional"`
    }

    ProjectManagementTaskPageRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        Page int64 `json:"page,default=1"`
        Limit int64 `json:"limit,default=20"`
        Filter ProjectManagementTaskPageFilter `json:"filter,optional"`
    }

    ProjectManagementTaskPageResponse {
        Page int64 `json:"page"`
        Limit int64 `json:"limit"`
        Total int64 `json:"total"`
        TotalPage int64 `json:"total_page"`
        List []*ProjectManagementTaskEntity `json:"list"`
    }

    ProjectManagementTaskCreateRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        ParentTaskId int64 `json:"parent_task_id,optional"`
        Title string `json:"title" validate:"required,max=255"`
        Description string `json:"description,optional"`
        Priority string `json:"priority,optional" validate:"max=32"`
        StartAt string `json:"start_at,optional"`
        EndAt string `json:"end_at,optional"`
        TaskTypeId int64 `json:"task_type_id,optional"`
        AssigneeIds []int64 `json:"assignee_ids,optional"`
    }

    ProjectManagementTaskDetailRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
    }

    ProjectManagementTaskUpdateRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        Title string `json:"title" validate:"required,max=255"`
        Description string `json:"description,optional"`
        Priority string `json:"priority,optional" validate:"max=32"`
        StartAt string `json:"start_at,optional"`
        EndAt string `json:"end_at,optional"`
        TaskTypeId int64 `json:"task_type_id,optional"`
    }

    ProjectManagementTaskDeleteRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        Confirm bool `json:"confirm" validate:"required"`
    }

    ProjectManagementMyTaskPageRequest {
        Page int64 `json:"page,default=1"`
        Limit int64 `json:"limit,default=20"`
        Filter ProjectManagementMyTaskPageFilter `json:"filter,optional"`
    }

    ProjectManagementMyTaskPageFilter {
        ProjectId int64 `json:"project_id,optional"`
        StageId int64 `json:"stage_id,optional"`
        TaskTypeId int64 `json:"task_type_id,optional"`
        AssigneeId int64 `json:"assignee_id,optional"`
        Keyword string `json:"keyword,optional"`
        Overdue *bool `json:"overdue,optional"`
    }

    ProjectManagementTaskAssigneeUpdateRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        AssigneeIds []int64 `json:"assignee_ids"`
    }

    ProjectManagementAttachmentPageRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        Page int64 `json:"page,default=1"`
        Limit int64 `json:"limit,default=20"`
    }

    ProjectManagementAttachmentPageResponse {
        Page int64 `json:"page"`
        Limit int64 `json:"limit"`
        Total int64 `json:"total"`
        TotalPage int64 `json:"total_page"`
        List []*ProjectManagementAttachmentEntity `json:"list"`
    }

    ProjectManagementAttachmentCreateRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        FileName string `json:"file_name,optional" validate:"max=255"`
        FileUrl string `json:"file_url" validate:"required,max=255"`
        StorageType string `json:"storage_type,optional" validate:"max=20"`
    }

    ProjectManagementAttachmentDeleteRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        FileId int64 `path:"file_id" validate:"required,gt=0"`
    }
)

@server (
    desc: "borrower project management"
    version: v1
    group: project_management
    prefix: /api/v1
    middleware: AuthMiddleware
    tags: project_management
)
service borrower-api {
    @doc "page project tasks"
    @handler ProjectManagementTaskPage
    post /project_management/project/:id/task/page (ProjectManagementTaskPageRequest) returns (ProjectManagementTaskPageResponse)

    @doc "create project task"
    @handler ProjectManagementTaskCreate
    post /project_management/project/:id/task (ProjectManagementTaskCreateRequest) returns (ProjectManagementTaskEntity)

    @doc "get project task"
    @handler ProjectManagementTaskDetail
    get /project_management/task/:id (ProjectManagementTaskDetailRequest) returns (ProjectManagementTaskEntity)

    @doc "update project task"
    @handler ProjectManagementTaskUpdate
    put /project_management/task/:id (ProjectManagementTaskUpdateRequest) returns (ProjectManagementTaskEntity)

    @doc "delete project task"
    @handler ProjectManagementTaskDelete
    delete /project_management/task/:id (ProjectManagementTaskDeleteRequest) returns (EmptyResponse)

    @doc "replace project task assignees"
    @handler ProjectManagementTaskAssigneeUpdate
    put /project_management/task/:id/assignee (ProjectManagementTaskAssigneeUpdateRequest) returns (ProjectManagementTaskEntity)

    @doc "page project task attachments"
    @handler ProjectManagementAttachmentPage
    post /project_management/task/:id/attachment/page (ProjectManagementAttachmentPageRequest) returns (ProjectManagementAttachmentPageResponse)

    @doc "register project task attachment"
    @handler ProjectManagementAttachmentCreate
    post /project_management/task/:id/attachment (ProjectManagementAttachmentCreateRequest) returns (ProjectManagementAttachmentEntity)

    @doc "delete project task attachment"
    @handler ProjectManagementAttachmentDelete
    delete /project_management/task/:id/attachment/:file_id (ProjectManagementAttachmentDeleteRequest) returns (EmptyResponse)

    @doc "page my project tasks"
    @handler ProjectManagementMyTaskPage
    post /project_management/my_task/page (ProjectManagementMyTaskPageRequest) returns (ProjectManagementTaskPageResponse)
}
