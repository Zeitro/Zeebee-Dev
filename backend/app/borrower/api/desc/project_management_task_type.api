syntax = "v1"

info(
    title: "borrower-project-management-task-type-api"
    desc: "borrower project management task type types"
    version: "v1"
)

import "../../../../domains/zeebee/api/project_management_entity.api"

type (
    ProjectManagementTaskTypePageFilter {
        Keyword string `json:"keyword,optional"`
        Enabled *bool `json:"enabled,optional"`
    }

    ProjectManagementTaskTypePageRequest {
        Page int64 `json:"page,default=1"`
        Limit int64 `json:"limit,default=20"`
        Filter ProjectManagementTaskTypePageFilter `json:"filter,optional"`
    }

    ProjectManagementTaskTypePageResponse {
        Page int64 `json:"page"`
        Limit int64 `json:"limit"`
        Total int64 `json:"total"`
        TotalPage int64 `json:"total_page"`
        List []*ProjectManagementTaskTypeEntity `json:"list"`
    }

    ProjectManagementTaskTypeCreateRequest {
        Name string `json:"name" validate:"required,max=100"`
        Description string `json:"description,optional" validate:"max=500"`
        Color string `json:"color,optional" validate:"max=32"`
        Enabled bool `json:"enabled"`
    }

    ProjectManagementTaskTypeUpdateRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        Name string `json:"name" validate:"required,max=100"`
        Description string `json:"description,optional" validate:"max=500"`
        Color string `json:"color,optional" validate:"max=32"`
        Enabled bool `json:"enabled"`
    }

    ProjectManagementTaskTypeDeleteRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
    }
)

@server (
    desc: "borrower project management"
    version: v1
    group: project_management
    prefix: /api/v1
    middleware: AuthMiddleware
    tags: project_management
)
service borrower-api {
    @doc "page project task types"
    @handler ProjectManagementTaskTypePage
    post /project_management/task_type/page (ProjectManagementTaskTypePageRequest) returns (ProjectManagementTaskTypePageResponse)

    @doc "create project task type"
    @handler ProjectManagementTaskTypeCreate
    post /project_management/task_type (ProjectManagementTaskTypeCreateRequest) returns (ProjectManagementTaskTypeEntity)

    @doc "update project task type"
    @handler ProjectManagementTaskTypeUpdate
    put /project_management/task_type/:id (ProjectManagementTaskTypeUpdateRequest) returns (ProjectManagementTaskTypeEntity)

    @doc "delete project task type"
    @handler ProjectManagementTaskTypeDelete
    delete /project_management/task_type/:id (ProjectManagementTaskTypeDeleteRequest) returns (EmptyResponse)
}
