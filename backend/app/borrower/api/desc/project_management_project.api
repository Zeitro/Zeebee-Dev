syntax = "v1"

info(
    title: "borrower-project-management-project-api"
    desc: "borrower project management project types"
    version: "v1"
)

import "../../../../domains/zeebee/api/project_management_entity.api"
import "base.api"

type (
    ProjectManagementProjectPageFilter {
        Keyword string `json:"keyword,optional"`
        EntityId int64 `json:"entity_id,optional"`
        EntityType string `json:"entity_type,optional"`
    }

    ProjectManagementProjectPageRequest {
        Page int64 `json:"page,default=1"`
        Limit int64 `json:"limit,default=20"`
        Filter ProjectManagementProjectPageFilter `json:"filter,optional"`
    }

    ProjectManagementProjectPageResponse {
        Page int64 `json:"page"`
        Limit int64 `json:"limit"`
        Total int64 `json:"total"`
        TotalPage int64 `json:"total_page"`
        List []*ProjectManagementProjectEntity `json:"list"`
    }

    ProjectManagementProjectDetailResponse {
        ProjectManagementProjectEntity
    }

    ProjectManagementProjectCreateRequest {
        EntityId int64 `json:"entity_id,optional"`
        EntityType string `json:"entity_type,optional"`
        Name string `json:"name" validate:"required,max=100"`
        Description string `json:"description,optional" validate:"max=500"`
        CoverUrl string `json:"cover_url,optional" validate:"max=255"`
        WorkflowTemplateId int64 `json:"workflow_template_id" validate:"required,gt=0"`
    }

    ProjectManagementProjectUpdateRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        Name string `json:"name" validate:"required,max=100"`
        Description string `json:"description,optional" validate:"max=500"`
        CoverUrl string `json:"cover_url,optional" validate:"max=255"`
    }

    ProjectManagementProjectDeleteRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        Confirm bool `json:"confirm" validate:"required"`
    }

    ProjectManagementProjectOwnerTransferRequest {
        ProjectId int64 `path:"id" validate:"required,gt=0"`
        MemberId int64 `json:"member_id" validate:"required,gt=0"`
    }

    ProjectManagementProjectWorkflowUpdateRequest {
        Id int64 `path:"id" validate:"required,gt=0"`
        Name string `json:"name" validate:"required,max=100"`
        Description string `json:"description,optional" validate:"max=500"`
        Stages []*ProjectManagementWorkflowStageEntity `json:"stages" validate:"required,min=1,dive"`
        Transitions []*ProjectManagementWorkflowTransitionEntity `json:"transitions,optional" validate:"dive"`
    }
)

@server (
    desc: "borrower project management project"
    version: v1
    group: project_management_project
    prefix: /api/v1
    middleware: AuthMiddleware
    tags: project_management_project
)
service borrower-api {
    @doc "page"
    @handler Page
    post /project_management/project/page (ProjectManagementProjectPageRequest) returns (ProjectManagementProjectPageResponse)

    @doc "detail"
    @handler Detail
    get /project_management/project/:id (PathIdRequest) returns (ProjectManagementProjectDetailResponse)

    @doc "create"
    @handler Create
    post /project_management/project (ProjectManagementProjectCreateRequest) returns (ProjectManagementProjectDetailResponse)

    @doc "update"
    @handler Update
    put /project_management/project/:id (ProjectManagementProjectUpdateRequest) returns (ProjectManagementProjectDetailResponse)

    @doc "delete"
    @handler Delete
    delete /project_management/project/:id (ProjectManagementProjectDeleteRequest) returns (EmptyResponse)

    @doc "transfer owner"
    @handler TransferOwner
    post /project_management/project/:id/owner (ProjectManagementProjectOwnerTransferRequest) returns (EmptyResponse)

    @doc "workflow detail"
    @handler WorkflowDetail
    get /project_management/project/:id/workflow (PathIdRequest) returns (ProjectManagementWorkflowDetailResponse)

    @doc "workflow update"
    @handler WorkflowUpdate
    put /project_management/project/:id/workflow (ProjectManagementProjectWorkflowUpdateRequest) returns (ProjectManagementWorkflowDetailResponse)
}
