syntax = "v1"

info(
    title: "borrower-loan-api"
    desc: "loan-api http service description"
    version: "v1"
)
import "address.api"
import "loan_applicant.api"
import "loan_third_service.api"
import "loan_experience.api"
import "loan_borrower.api"
import "loan_demographic.api"
import "file.api"
import "loan_document.api"
import "loan_property.api"

type LoanEntry {
    Id int64 `json:"id,optional"`
    Code string `json:"code,optional"`
    Stage string `json:"stage" validate:"required,oneof=Pending Active Archived"`
    PendingStatus string `json:"pending_status,optional" validate:"required_if=Stage Pending,omitempty,oneof=Quoting Processing Underwriting Closing"`
    LoanPurpose string `json:"loan_purpose" validate:"required,oneof=Purchase 'Rate-term refi' 'Cash-out refi'"`
    LoanType string `json:"loan_type" validate:"required,oneof=Bridge Rehab  Rental 'Ground up construction'"`
    TotalAmount float64 `json:"total_amount"`
    InitialAmount float64 `json:"initial_amount,optional"`
    LoanProperty *LoanPropertyEntry `json:"loan_property" validate:"required"`
    LenderCompany string `json:"lender_company,optional" validate:"required"`
    ClosingDate string `json:"closing_date,optional" validate:"required_if=Stage Pending,omitempty,datetime=01/02/2006"`
    ClosingFund float64 `json:"closing_fund,optional" validate:"required_if=Stage Pending"`
    HoldbackAmount float64 `json:"holdback_amount,optional" validate:"required_if=Stage Pending"`
    Rate float32 `json:"rate" validate:"required,gt=0"`
    PrincipalAmount float64 `json:"principal_amount,optional" validate:"required_unless=Stage Pending"`
    MonthlyPayment float64 `json:"monthly_payment,optional" validate:"required_if=Stage Active,omitempty,gt=0"`
    LienPosition string `json:"lien_position,optional" validate:"required_if=Stage Active,omitempty,oneof=1st 2nd 3rd 4th Other"`
    MaturityDate string `json:"maturity_date,optional" validate:"required_if=Stage Active,omitempty,datetime=01/02/2006"`
    PrepaymentPenalty int32 `json:"prepayment_penalty,optional" validate:"gte=0,lte=12"`
    ServiceCompany string `json:"service_company,optional" validate:"required_if=Stage Active"`
    PaidOffDate string `json:"paid_off_date,optional" validate:"required_if=Stage Archived,omitempty,datetime=01/02/2006"`
    BusinessStrategy []string `json:"business_strategy" validate:"required,dive,required,oneof=Rental Sale Flip ADU/Addition 'Single Lot SFR' 'SB9 lot split' 'Conforming lot split' 'New Condo/TH' 'Community development (>3 units)' Commercial"`
    Applicants []LoanApplicantEntry `json:"applicants"`
    LenderID int64 `json:"lender_id"`
    BorrowerID int64 `json:"borrower_id"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    Source string `json:"source"`
    LoanTerm int32 `json:"loan_term" `
    Arv float64 `json:"arv"`
    Ltv float64 `json:"ltv"`
    EstCreditScore int32 `json:"est_credit_score"`
    ReservesAmount float64 `json:"reserves_amount"`
    HasCollateralizedBlanket bool `json:"has_collateralized_blanket"`
    TransactionExperiences []*LoanExperienceEntry `json:"transaction_experiences"`
    RealEstateExperiences []*LoanExperienceEntry `json:"real_estate_experiences"`
    LoanThirdServices []*LoanThirdServiceEntry `json:"loan_third_services"`
    LoanBorrower *LoanBorrowerEntry `json:"loan_borrower"`
    LoanDemographic *LoanDemographicEntry `json:"loan_demographic"`
    OriginalContractDate string `json:"original_contract_date,optional"`
    ExtensionDate string `json:"extension_date,optional"`
    LoanProcessor string `json:"loan_processor"`
    Extend *ImportLoanExtendEntry `json:"extend"`
    LoanDocuments []*LoanDocumentEntry `json:"loan_documents"`
    RequestedLoanDocumentCount int64 `json:"requested_loan_document_count"`

    // moved to loan_property
    //    ExistingLenderCompany string `json:"existing_lender_company"`
    //    ExistingRate float32 `json:"existing_rate" `
    //    ExistingMaturityDate string `json:"existing_maturity_date"`
    //    PurchaseAmount float64 `json:"purchase_amount"`
    //    PurchaseDate string `json:"purchase_date" `
    //    HasAssignmentFee bool `json:"has_assignment_fee"`
    //    AssignmentFeeAmount float64 `json:"assignment_fee_amount"`
    //    HasSubordinateDebt bool `json:"has_subordinate_debt"`
    //    SubordinateDebtAmount float64 `json:"subordinate_debt_amount"`
    //    ScheduledCloseEscrowDate string `json:"scheduled_close_escrow_date"`
    //    EstPropertyValueAmount float64 `json:"est_property_value_amount"`
    //    LiquidityAmount float64 `json:"liquidity_amount"`
    //    Budget *LoanBudgetEntry `json:"budget"`
    //    MidConstruction bool `json:"mid_construction"`
    //    EstYearlyRentalIncome float64 `json:"est_yearly_rental_income" `
    //    YearlyLiabilityExpense float64 `json:"yearly_liability_expense" `
    //    Dscr float32 `json:"dscr" `
    //    HasDelayedFinancing bool `json:"has_delayed_financing"`
    //    HasPropertiesVacant bool `json:"has_properties_vacant"`
    //    HasShortTermRental bool `json:"has_short_term_rental"`
    //    AdditionalInfo string `json:"additional_info"`
}

// create third party loan
type (
    LoanCreateRequest {
        Stage string `json:"stage" validate:"required,oneof=Pending Active Archived"`
        PendingStatus string `json:"pending_status,optional" validate:"required_if=Stage Pending,omitempty,oneof=Quoting Processing Underwriting Closing"`
        LoanPurpose string `json:"loan_purpose,optional" validate:"required,oneof=Purchase 'Rate-term refi' 'Cash-out refi'"`
        LoanType string `json:"loan_type" validate:"required,oneof=Bridge Rehab Rental 'Ground up construction'"`
        TotalAmount float64 `json:"total_amount,optional"  validate:"required_unless=Stage Archived"`
        InitialAmount float64 `json:"initial_amount,optional"`
        LoanProperty *LoanPropertyEditEntry `json:"loan_property,optional" validate:"required"`
        Applicants []*ThirdPartyLoanApplicantEntry `json:"applicants,optional" validate:"required,min=1,max=2,dive,required"`
        BorrowerEntityId int64 `json:"borrower_entity_id" validate:"required,gt=0"`
        LenderCompany string `json:"lender_company,optional" validate:"required"`
        ClosingDate string `json:"closing_date,optional" validate:"required_if=Stage Pending,omitempty,datetime=01/02/2006"`
        ClosingFund float64 `json:"closing_fund,optional" validate:"gte=0,ltefield=TotalAmount"`
        HoldbackAmount float64 `json:"holdback_amount,optional" validate:"gte=0,ltefield=TotalAmount"`
        Rate float32 `json:"rate,optional" validate:"required,gt=0,lt=100"`
        PrincipalAmount float64 `json:"principal_amount,optional" validate:"required_unless=Stage Pending"`
        MonthlyPayment float64 `json:"monthly_payment,optional" validate:"required_if=Stage Active,omitempty,gt=0"`
        LienPosition string `json:"lien_position,optional" validate:"required_if=Stage Active,omitempty,oneof=1st 2nd 3rd 4th Other"`
        MaturityDate string `json:"maturity_date,optional" validate:"required_if=Stage Active,omitempty,datetime=01/02/2006"`
        PrepaymentPenalty int32 `json:"prepayment_penalty,optional" validate:"gte=0,lte=12"`
        ServiceCompany string `json:"service_company,optional" validate:"required_if=Stage Active"`
        PaidOffDate string `json:"paid_off_date,optional" validate:"required_if=Stage Archived,omitempty,datetime=01/02/2006"`
        BusinessStrategy []string `json:"business_strategy,optional" validate:"required,dive,required,oneof=Rental Sale Flip ADU/Addition 'Single Lot SFR' 'SB9 lot split' 'Conforming lot split' 'New Condo/TH' 'Community development (>3 units)' Commercial"`

        PurchaseAmount float64 `json:"purchase_amount,optional"`
        PurchaseDate string `json:"purchase_date,optional"`
        Extend *ImportLoanExtendEntry `json:"extend,optional"`
        ExistingLenderCompany string `json:"existing_lender_company,optional"`
        OriginalContractDate string `json:"original_contract_date,optional"`
        ExtensionDate string `json:"extension_date,optional"`
        LoanProcessor string `json:"loan_processor,optional"`
    }

    LoanCreateResponse {
        Id int64 `json:"id"`
    }
)

// update third party loan
type (
    LoanUpdateRequest {
        Id int64 `path:"id" validate:"required,min=1"`
        Stage string `json:"stage" validate:"required,oneof=Pending Active Archived"`
        PendingStatus string `json:"pending_status,optional" validate:"required_if=Stage Pending,omitempty,oneof=Quoting Processing Underwriting Closing"`
        LoanPurpose string `json:"loan_purpose,optional" validate:"required,oneof=Purchase 'Rate-term refi' 'Cash-out refi'"`
        LoanType string `json:"loan_type,optional" validate:"required,oneof=Bridge Rehab Rental 'Ground up construction'"`
        TotalAmount float64 `json:"total_amount,optional"  validate:"required_unless=Stage Archived"`
        InitialAmount float64 `json:"initial_amount,optional"`
        LoanProperty *LoanPropertyEditEntry `json:"loan_property,optional" validate:"required"`
        Applicants []*ThirdPartyLoanApplicantEntry `json:"applicants,optional" validate:"required,dive,required"`
        BorrowerEntityId int64 `json:"borrower_entity_id" validate:"required,gt=0"`
        LenderCompany string `json:"lender_company,optional" validate:"required"`
        ClosingDate string `json:"closing_date,optional" validate:"required_if=Stage Pending,omitempty,datetime=01/02/2006"`
        ClosingFund float64 `json:"closing_fund,optional" validate:"gte=0,ltefield=TotalAmount"`
        HoldbackAmount float64 `json:"holdback_amount,optional" validate:"gte=0,ltefield=TotalAmount"`
        Rate float32 `json:"rate,optional" validate:"required,gt=0"`
        PrincipalAmount float64 `json:"principal_amount,optional" validate:"required_unless=Stage Pending"`
        MonthlyPayment float64 `json:"monthly_payment,optional" validate:"required_if=Stage Active,omitempty,gt=0"`
        LienPosition string `json:"lien_position,optional" validate:"required_if=Stage Active,omitempty,oneof=1st 2nd 3rd 4th Other"`
        MaturityDate string `json:"maturity_date,optional" validate:"required_if=Stage Active,omitempty,datetime=01/02/2006"`
        PrepaymentPenalty int32 `json:"prepayment_penalty,optional" validate:"gte=0,lte=12"`
        ServiceCompany string `json:"service_company,optional" validate:"required_if=Stage Active"`
        PaidOffDate string `json:"paid_off_date,optional" validate:"required_if=Stage Archived,omitempty,datetime=01/02/2006"`
        BusinessStrategy []string `json:"business_strategy,optional" validate:"required,dive,required,oneof=Rental Sale Flip ADU/Addition 'Single Lot SFR' 'SB9 lot split' 'Conforming lot split' 'New Condo/TH' 'Community development (>3 units)' Commercial"`

        PurchaseAmount float64 `json:"purchase_amount,optional"`
        PurchaseDate string `json:"purchase_date,optional"`
        Extend *ImportLoanExtendEntry `json:"extend,optional"`
        ExistingLenderCompany string `json:"existing_lender_company,optional"`
        OriginalContractDate string `json:"original_contract_date,optional"`
        ExtensionDate string `json:"extension_date,optional"`
        LoanProcessor string `json:"loan_processor,optional"`
    }
)

// update state
type (
    LoanUpdatePendingStatusRequest {
        Id int64 `path:"id"`
        PendingStatus string `json:"pending_status" validate:"required,oneof=Quoting Processing Underwriting Closing"`
    }
)

// delete loan
type (
    LoanDeleteRequest {
        Id int64 `path:"id"`
    }
)

// loan detail
type (
    LoanDetailRequest {
        Id int64 `path:"id"`
    }
    LoanDetailResponse {
        LoanEntry
    }
)

// loan page
type (
    LoanPageFilter {
        Stage string `json:"stage,optional"`
        Keyword string `json:"keyword,optional"`
        KeywordType string `json:"keyword_type,optional"`
        PendingStatus []string `json:"pending_status,optional"`
        LoanPurpose []string `json:"loan_purpose,optional" `
        LoanType []string `json:"loan_type,optional"`
        Lender []string `json:"lender,optional"`
    }

    LoanPageSorter {
        Column string `json:"column,optional"`
        Sort string `json:"sort,optional"`
    }

    LoanPageRequest {
        Page int64 `json:"page,optional"`
        Limit int64 `json:"limit,optional"`
        Filter LoanPageFilter `json:"filter,optional"`
        Sorter LoanPageSorter `json:"sorter,optional"`
    }

    LoanPageResponse {
        Page int64 `json:"page"`
        Limit int64 `json:"limit"`
        Total int64 `json:"total"`
        TotalPage int64 `json:"total_page"`
        List []LoanEntry `json:"list"`
    }
)

// apply loan
type (
    LoanApplyRequest {
        Id int64 `path:"id,optional"`
        Code string `json:"code,optional" validate:"omitempty,number,min=15,max=100"`
        LoanType string `json:"loan_type,optional" validate:"required,oneof=Bridge Rehab Rental 'Ground up construction'"`
        LoanPurpose string `json:"loan_purpose,optional" validate:"required,oneof=Purchase 'Rate-term refi' 'Cash-out refi'"`
        TotalAmount float64 `json:"total_amount,optional" validate:"required,gt=0"`
        InitialAmount float64 `json:"initial_amount,optional" validate:"ltefield=TotalAmount"`
        //        LoanProperty *LoanApplyPropertyEntry `json:"loan_property,optional"`
        LoanProperty *LoanPropertyApplyEntry `json:"loan_property,optional"`
        HoldbackAmount float64 `json:"holdback_amount,optional" validate:"ltefield=TotalAmount"`
        PrincipalAmount float64 `json:"principal_amount,optional" validate:"required_unless=LoanPurpose Purchase,omitempty,gte=0"`
        // MaturityDate string `json:"maturity_date, optional"`
        PrepaymentPenalty int32 `json:"prepayment_penalty,optional" validate:"required_if=LoanType Rental,omitempty,gte=0"`
        BusinessStrategy []string `json:"business_strategy,optional" validate:"required,dive,required,oneof=Rental Sale Flip ADU/Addition 'Single Lot SFR' 'SB9 lot split' 'Conforming lot split' 'New Condo/TH' 'Community development (>3 units)' Commercial"`
        Applicants []*LoanApplicantApplyEntry `json:"applicants,optional" validate:"required,gt=0,lte=2"`
        LoanTerm int32 `json:"loan_term,optional" validate:"gte=1"`
        Arv float64 `json:"arv,optional" validate:"required,gte=0"`
        // EstCreditScore int32 `json:"est_credit_score"`
        ReservesAmount float64 `json:"reserves_amount,optional" validate:"required_if=LoanType Rental,omitempty,gt=0"`
        TransactionExperiences []*LoanExperienceEntry `json:"transaction_experiences,optional"`
        RealEstateExperiences []*LoanExperienceEntry `json:"real_estate_experiences,optional"`
        LoanThirdServices []*LoanThirdServiceEntry `json:"loan_third_services,optional"`
        //        LoanBorrower *LoanBorrowerEntry `json:"loan_borrower,optional" validate:"required"`
        BorrowerEntityId int64 `json:"borrower_entity_id,optional" validate:"required,gt=0"`
        LoanDemographic *LoanDemographicEntry `json:"loan_demographic,optional" validate:"required"`
        ApplyFormFile string `json:"apply_form_file,optional" validate:"required"`

        // remove to loan property
        //        ExistingLenderCompany string `json:"existing_lender_company,optional" validate:"required_unless=LoanPurpose Purchase"`
        //        ExistingRate float32 `json:"existing_rate,optional,optional" validate:"required_unless=LoanPurpose Purchase,omitempty,gt=0,lt=100"`
        //        ExistingMaturityDate string `json:"existing_maturity_date,optional" validate:"required_unless=LoanPurpose Purchase,omitempty,datetime=01/02/2006"`
        //        PurchaseAmount float64 `json:"purchase_amount,optional" validate:"required,gt=0"`
        //        PurchaseDate string `json:"purchase_date,optional" validate:"required_unless=LoanPurpose Purchase,omitempty,datetime=01/02/2006"`
        //        HasAssignmentFee bool `json:"has_assignment_fee,optional"`
        //        AssignmentFeeAmount float64 `json:"assignment_fee_amount,optional" validate:"required_if=HasAssignmentFee true,omitempty,gt=0"`
        //        HasSubordinateDebt bool `json:"has_subordinate_debt,optional"`
        //        SubordinateDebtAmount float64 `json:"subordinate_debt_amount,optional" validate:"required_if=HasSubordinateDebt true,omitempty,gt=0"`
        //        ScheduledCloseEscrowDate string `json:"scheduled_close_escrow_date,optional" validate:"required_if=LoanPurpose Purchase,omitempty,datetime=01/02/2006"`
        //        EstPropertyValueAmount float64 `json:"est_property_value_amount,optional" validate:"required_unless=LoanPurpose Purchase,omitempty,gte=0"`
        //        LiquidityAmount float64 `json:"liquidity_amount,optional" validate:"gte=0"`
        //        Budget *LoanBudgetEntry `json:"budget,optional" validate:"required_if=LoanType Rehab LoanType 'Ground up construction'"`
        //        MidConstruction bool `json:"mid_construction,optional"`
        //        EstYearlyRentalIncome float64 `json:"est_yearly_rental_income,optional" validate:"required_if=LoanType Rental,omitempty,gt=0"`
        //        YearlyLiabilityExpense float64 `json:"yearly_liability_expense,optional" validate:"required_if=LoanType Rental,omitempty,gt=0"`
        //        Dscr float32 `json:"dscr,optional" validate:"required_if=LoanType Rental,omitempty,gt=0"`
        //        HasDelayedFinancing bool `json:"has_delayed_financing,optional"`
        //        HasCollateralizedBlanket bool `json:"has_collateralized_blanket,optional"`
        //        HasPropertiesVacant bool `json:"has_properties_vacant,optional"`
        //        HasShortTermRental bool `json:"has_short_term_rental,optional"`
    }

    LoanApplyResponse {
        Id int64 `json:"id"`
    }
)

// loan lender companies
type (
    LoanLenderCompanyResponse {
        LenderCompanies []string `json:"lender_companies"`
    }
)

type (
    ImportLoanRequest {
        Stage string `form:"stage" validate:"required,oneof=Pending,Active,Archived"`
    }
    ImportLoanResponse {
        RecordCount int64 `json:"record_count" `
    }
)


type ImportPendingLoanEntry {
    BorrowerId int64 `json:"borrower_id" validate:"required,gt=0"`
    // property address
    LoanProperty *ImportLoanApplyPropertyEntry `json:"loan_property,optional"`
    // applicants
    Applicants []*ImportLoanApplicantEntry `json:"applicants,optional" validate:"required,gt=0,lte=2"`
    // borrower
    LoanBorrower *ImportLoanBorrowerEntry `json:"loan_borrower,optional" validate:"required"`
    // loan
    ClosingDate string `json:"closing_date,optional"`
    MaturityDate string `json:"maturity_date,optional"`
    ClosingFund float64 `json:"closing_fund,optional"`
    LenderCompany string `json:"lender_company,optional"`
    LoanType string `json:"loan_type, optional"`
    TotalAmount float64 `json:"total_amount,optional"`
    // => 1st Loan Amount
    HoldbackAmount float64 `json:"holdback_amount,optional"`
    // ExistingRate float32 `json:"existing_rate,optional"`
    ExistingLenderCompany string `json:"existing_lender_company,optional"`
    OriginalContractDate string `json:"original_contract_date,optional"`
    ExtensionDate string `json:"extension_date,optional"`
    LoanProcessor string `json:"loan_processor,optional"`
    // extend
    Extend *ImportLoanExtendEntry `json:"extend,optional"`
}

type ImportLoanExtendEntry {
    Pricing string `json:"pricing,optional"`
    LoanStatusUpdates string `json:"loan_status_updates,optional"`
    MeetingNotes string `json:"meeting_notes,optional"`
    ActionList string `json:"action_list,optional"`
    BusinessLine string `json:"business_line,optional"`
}

type (
    LoanPreApprovalRequestBorrower {
        Name string `json:"name" validate:"required,min=1,max=100"`
        Email string `json:"email" validate:"required,email"`
        Phone string `json:"phone" validate:"required"`
        EstCreditScore int32 `json:"est_credit_score" validate:"required,gte=300,lte=850"`
        FlipPropertyCount int32 `json:"flip_property_count" validate:"gte=0"`
        PurchaseRentalPropertyCount int32 `json:"purchase_rental_property_count" validate:"gte=0"`
    }

    LoanPreApprovalRequestProperty {
        Address *AddressEntry `json:"address" validate:"required"`
        PropertyType string `json:"property_type" validate:"required,oneof='Single Family Residence' '2 unit' '3 unit' '4 unit' '4+ Multi' 'Townhouse' 'PUD/Condominium' 'Mixed Use' 'Commercial'"`
        IsPermitReady bool `json:"is_permit_ready,optional"`
        Unit int32 `json:"unit" validate:"gte=1,lte=100"`
    }

    LoanPreApprovalRequestLoan {
        LoanTerm int32 `json:"loan_term" validate:"required,gte=1,lte=360"`
        EstPropertyValueAmount float64 `json:"est_property_value_amount" validate:"required,gt=0"`
        Arv float64 `json:"arv,optional" validate:"required,gt=0"`
        TotalAmount float64 `json:"total_amount,optional" validate:"required,gt=0"`
        PrincipalAmount float64 `json:"principal_amount,optional" validate:"required_if=LoanPurpose 'Rate-term refi' LoanPurpose 'Cash-out refi'"`
        PurchaseDate string `json:"purchase_date,optional" validate:"required_if=LoanPurpose 'Rate-term refi' LoanPurpose 'Cash-out refi',omitempty,datetime=01/02/2006"`
        PurchaseAmount float64 `json:"purchase_amount" validate:"required,gt=0"`
        CostSpentToDateAmount float64 `json:"cost_spent_to_date_amount,optional" validate:"required_if=LoanPurpose 'Rate-term refi' LoanPurpose 'Cash-out refi',gte=0"`
        BudgetAmount float64 `json:"budget_amount,optional" validate:"required_if=LoanType Rehab,gte=0"`
        InitialAmount float64 `json:"initial_amount,optional" validate:"required_if=LoanType Rehab LoanType 'Ground up construction',gte=0"`
        HoldbackAmount float64 `json:"holdback_amount,optional" validate:"required_if=LoanType Rehab LoanType 'Ground up construction',gte=0"`
        InterestReserveMonths int32 `json:"interest_reserve_months,optional" validate:"gte=0"`
        LoanPurpose string `json:"loan_purpose" validate:"required,oneof=Purchase 'Rate-term refi' 'Cash-out refi'"`
        LoanType string `json:"loan_type" validate:"required,oneof=Bridge Rehab 'Ground up construction'"`
        HasAssignmentFee bool `json:"has_assignment_fee,optional"`
        AssignmentFeeAmount float64 `json:"assignment_fee_amount,optional" validate:"required_if=HasAssignmentFee true,gte=0"`
    }

    LoanPreApprovalRequest {
        RequestId string `json:"request_id, optional"`
        Borrower *LoanPreApprovalRequestBorrower `json:"borrower" validate:"required"`
        Property *LoanPreApprovalRequestProperty `json:"property" validate:"required"`
        Loan *LoanPreApprovalRequestLoan `json:"loan" validate:"required"`
    }
    LoanPreApprovalResponse {
        Primary *PrimaryPreApprovalLoan `json:"primary"`
        Secondaries []*SecondaryPreApprovalLoan `json:"secondaries"`
    }
    PrimaryPreApprovalLoan {
        LenderCompanyId int64 `json:"lender_company_id"`
        LenderCompanyName string `json:"lender_company_name"`
        IsApproved bool `json:"is_approved"`
        TotalAmount float64 `json:"total_amount"`
        Rate float32 `json:"rate"`
        MonthlyPayment float64 `json:"monthly_payment"`
        CashToClose float64 `json:"cash_to_close"`
        InitialAmount float64 `json:"initial_amount"`
        HoldbackAmount float64 `json:"holdback_amount"`
        LoanTerm int32 `json:"loan_term"`
        Ltv float32 `json:"ltv"`
        Ltarv float32 `json:"ltarv"`
        Ltc float32 `json:"ltc"`
        RejectReason string `json:"reject_reason"`
        RequestId string `json:"request_id"`
    }
    SecondaryPreApprovalLoan {
        LenderCompanyId int64 `json:"lender_company_id"`
        LenderCompanyName string `json:"lender_company_name"`
        TotalAmount *SecondaryPreApprovalLoanRangeFloat `json:"total_amount"`
        Rate *SecondaryPreApprovalLoanRangeFloat `json:"rate"`
        LoanTerm *SecondaryPreApprovalLoanRangeInt `json:"loan_term"`
    }
    SecondaryPreApprovalLoanRangeFloat {
        Min float64 `json:"min"`
        Max float64 `json:"max"`
    }
    SecondaryPreApprovalLoanRangeInt {
        Min int32 `json:"min"`
        Max int32 `json:"max"`
    }
)

type SendPreApprovalLoanNotificationRequest {
    RequestId string `json:"request_id" validate:"required,number,gte=10"`
    LenderCompanyId int64 `json:"lender_company_id" validate:"required,min=1"`
}

