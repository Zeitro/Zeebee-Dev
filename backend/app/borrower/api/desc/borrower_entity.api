syntax = "v1"

info(
    title: "borrower-entity-api"
    desc: "borrower-entity-api http service description"
    version: "v1"
)

import "address.api"


type BorrowerEntityEntry {
    Id int64 `json:"id"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    BorrowerId int64 `json:"borrower_id"`
    Type string `json:"type"`
    Name string `json:"name"`
    TinType string `json:"tin_type"`
    Tin string `json:"tin"`
    MailingAddress AddressEntry `json:"mailing_address"`
    ContactEmail string `json:"contact_email"`
    ContactName string `json:"contact_name"`
    ContactPhone string `json:"contact_phone"`
    //    OwnPercent int32 `json:"own_percent"`
}

type BorrowerEntityPageEntry {
    Id int64 `json:"id"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    BorrowerId int64 `json:"borrower_id"`
    Type string `json:"type"`
    Name string `json:"name"`
    TinType string `json:"tin_type"`
    Tin string `json:"tin"`
    ContactEmail string `json:"contact_email"`
    ContactName string `json:"contact_name"`
    ContactPhone string `json:"contact_phone"`
    //    OwnPercent int32 `json:"own_percent"`
    MailingAddress *AddressEntry `json:"mailing_address,omitempty"`
}

type BorrowerEntityEditRequest {
    Id int64 `path:"id,optional"`
    Type string `json:"type" validate:"required,oneof=Corporation LLC Partnership Trust"`
    Name string `json:"name" validate:"required,min=2,max=100"`
    TinType string `json:"tin_type" validate:"required,oneof=EIN"`
    Tin string `json:"tin" validate:"required,min=9,max=9"`
    MailingAddress AddressEntry `json:"mailing_address" validate:"required"`
    ContactEmail string `json:"contact_email" validate:"required,email,min=5,max=100"`
    ContactName string `json:"contact_name" validate:"required,min=5,max=100"`
    ContactPhone string `json:"contact_phone" validate:"required,min=9,max=15"`
    //    OwnPercent int32 `json:"own_percent" validate:"required,min=1,max=100"`
}


// page
type (
    BorrowerEntityPageFilter {
        Keyword string `json:"keyword,optional"`
    }

    BorrowerEntityPageSorter {
        Column string `json:"column,optional"`
        Sort string `json:"sort,optional"`
    }

    BorrowerEntityPageRequest {
        Page int64 `json:"page,optional"`
        Limit int64 `json:"limit,optional"`
        Filter BorrowerEntityPageFilter `json:"filter,optional"`
        Sorter BorrowerEntityPageSorter `json:"sorter,optional"`
    }

    BorrowerEntityPageResponse {
        Page int64 `json:"page"`
        Limit int64 `json:"limit"`
        Total int64 `json:"total"`
        TotalPage int64 `json:"total_page"`
        List []BorrowerEntityPageEntry `json:"list"`
    }
)

// check existed
type (
    BorrowerEntityCheckExistedRequest {
        Name string `form:"name"`
        Id int64 `form:"id,optional"`
    }

    BorrowerEntityCheckExistedResponse {
        IsExisted bool `json:"is_existed"`
    }
)

// edit
type (
    BorrowerEntityCreateRequest {
        BorrowerEntityEditRequest
    }

    BorrowerEntityCreateResponse {
        BorrowerEntityEntry
    }

    BorrowerEntityUpdateRequest {
        BorrowerEntityEditRequest
    }

    BorrowerEntityUpdateResponse {
        BorrowerEntityEntry
    }
)

// detail
type (
    BorrowerEntityDetailResponse {
        BorrowerEntityEntry
    }
)
// all
type (
    BorrowerEntityAllResponse {
        Lists []*BorrowerEntityPageEntry `json:"lists"`
    }
)
