entity borrower_entities {
    * id: int4 <<pk>>
    --
    created_at: timestamptz
    updated_at: timestamptz
    is_del: int2
    --
    organization_id: int4
    type: varchar(50)
    name: varchar(100)
    tin_type: varchar(50)
    tin: varchar(20)
    mailing_address: jsonb
    contact_email: varchar(100)
    contact_phone: varchar(20)
    contact_name: varchar(100)
    creator_id: int4
    creator_name: varchar(200)
    --
    ..Indexes..
    organization_id
}
note right of borrower_entities
    type:
        - Corporation
        - LLC
        - Partnership
        - Trust
    tin_type:
        - EIN
end note

entity loans {
    * id: int4 <<pk>>
    --
    created_at: timestamptz
    updated_at: timestamptz
    is_del: int2
    --
    code: varchar(100)
    lender_organization_id: int4
    borrower_organization_id: int4
    lender_company: varchar(100)
    service_company: varchar(100)
    stage : varchar(10)
    pending_status : varchar(10)
    purpose: varchar(20)
    loan_type: varchar(30)
    total_amount: numeric(10,2)
    principle_amount: numeric(10,2)
    initial_amount: numeric(10,2)
    holdback_amount: numeric(10,2)
    holdback_released_amount: numeric(10,2)
    lien_position: varchar(10)
    rate: numeric(4,2)
    closing_fund: numeric(10,2)
    closing_date: date
    maturity_date: date
    paid_off_date: int4
    monthly_payment: numeric(10,2)
    business_strategy: text[]
    source: varchar(30)
    prepayment_penalty: int2
    loan_term: int2
    ltv: numeric(10,2)
    est_credit_score: int2
    reserves_amount: numeric(10,2)
    original_contract_date: date
    extension_date: date
    loan_processor: varchar(100)
    extend: jsonb
    creator_id: int4
    creator_name: varchar(200)
    --
    ..Indexes..
    code
    lender_organization_id
    borrower_organization_id
}

note right of loans
    stage:
        - Draft
        - Pending
        - Active
        - Archived
        - Rejected
    pending_status:
        - Quoting
        - Processing
        - Underwriting
        - Closing
    purpose:
        - Purchase
        - Rate-term refi
        - Cash-out refi
    loan_type:
        - Bridge
        - Rehab
        - Rental
        - Ground up construction
    lien_position:
        - 1st
        - 2nd
        - 3rd
        - 4th
        - Other
    business_strategy:
        - Sale
        - Rent
        - Flip
        - ADU/Addition
        - Single Lot SFR
        - SB9 lot split
        - Conforming lot split
        - New Condo/TH
        - Community development (>3 units)
        - Commercial
    source:
        - borrower
        - lender
        - system
        - pre approval
    budget{
        original_budget numeric(10,2)
        remaining_budget numeric(10,2)
        cost_spent_to_date_amount numeric(10,2)
    }
end note

entity loan_borrowers{
