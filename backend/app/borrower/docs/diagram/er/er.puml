@startuml
skinparam linetype ortho

entity users{
    * id: serial <<pk>>
    --
    created_at: timestamptz
    updated_at: timestamptz
    is_del: int2
    --
    email: varchar(100)
    password_hash: varchar(100)
    status: varchar(10)
    type: varchar(10)
    first_name: varchar(100)
    mid_name: varchar(100)
    last_name: varchar(100)
    full_name: varchar(200)
    default_organization_id: int4
    phone: varchar(20)
    --
    ..Indexes..
    email
    (first_name,mid_name,last_name,full_name)
    default_organization_id
    phone
}

note right of users
    status:
        - Unverified
        - Active
        - Inactive
    type:
        - Borrower
        - Lender
        - Admin
end note

entity organizations {
    *     id: int4 <<pk>>
    --
    created_at: timestamptz
    updated_at: timestamptz
    is_del: int2
    --
    name:varchar(100)
    status: varchar(20)
    owner_id: int4
    address: jsonb
    contact_email: varchar(100)
    owner_type: varchar(50)
    type: varchar(20)
    contact_name: varchar(100)
    contact_phone: varchar(20)
    logo: varchar(255)
    website: varchar(255)
    --
    ..Indexes..
    name
    owner_id
}

note right of organizations
    status:
        - Active
        - Inactive
    owner_type:
        - ""
        - Self
        - ThirdParty
        - Partner
    type:
        - Borrower
        - Lender
        - Admin
end note

entity organization_users{
    * id: serial <<pk>>
    --
    created_at: timestamptz
    updated_at: timestamptz
    is_del: int2
    --
    organization_id: int4
    user_id: int4
    first_name: varchar(100)
    mid_name: varchar(100)
    last_name: varchar(100)
    full_name: varchar(100)
    status: varchar(20)
    phone: varchar(20)
    remark: varchar(255)
    --
    ..Indexes..
    organization_id
    user_id
    (first_name,mid_name,last_name,full_name)
}

note right of organization_users
    status:
        - Active
        - Disabled
        - Not Activated
end note

entity roles {
    * id: int4 <<pk>>
    --
    created_at: timestamptz
    updated_at: timestamptz
    is_del: int2
    --
    name: varchar(100)
    type: varchar(20)
    status: varchar(20)
    description: varchar(255)
    organization_id: int4
    --
    ..Indexes..
    organization_id
    (name,type)
}

note right of roles
    type:
        - Borrower
        - Lender
        - Admin
    status:
        - Active
        - Inactive
end note

entity organization_user_and_roles {
    * id: int4 <<pk>>
    --
    organization_user_id: int4
    role_id: int4
    --
    ..Indexes..
    organization_user_id
    role_id
}

entity borrower_properties {
    * id: int4 <<pk>>
    --
    created_at: timestamptz
    updated_at: timestamptz
    is_del: int2
    --
    unit: int2
    organization_id: int4
    total_amount: numeric(10,2)
    address: jsonb
    property_type: varchar(50)
    living_area_sqft: decimal(8,2)
    bedrooms: int2
    bathrooms: int2
    loan_count: int4
    creator_id: int4
    creator_name: varchar(200)
    --
    ..Indexes..
    organization_id
}

note right of borrower_properties
    address {
        state
        city
        zip_code
        address1
        address2
    }
    property_type:
        - Single Family Residence
        - 2 unit
        - 3 unit
        - 4 unit
        - 4+ Multi
        - Townhouse
        - PUD/Condominium
        - Mixed Use
        - Commercial
end note

entity borrower_applicants{
    * id: int4 <<pk>>
    --
    created_at: timestamptz
    updated_at: timestamptz
    is_del: int2
    --
    organization_id: int4
    first_name: varchar(100)
    last_name: varchar(100)
    mid_name: varchar(100)
    full_name: varchar(255)
    ssn: varchar(20)
    dob: date
    marital_status: varchar(20)
