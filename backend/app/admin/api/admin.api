syntax = "v1"

info(
	title: "admin-api http service"
    desc: "admin-api http service description"
)

import "desc/user.api"
import "desc/api.api"
import "desc/resource.api"
import "desc/role.api"
import "desc/organization_user.api"
import "desc/organization.api"
import "desc/storage.api"
import "desc/us_geography.api"
import "desc/common.api"
import "desc/base_template.api"
import "desc/loan.api"

// ============== common start =============
@server(
    desc: "admin-api service"
	version: v1
    group: common
	prefix:  /api/v1
    tags: common
)
service admin-api {
	@doc "select options"
	@handler SelectOptions
	get /select_options (GetSelectOptionRequest) returns (GetSelectOptionResponse)

	@doc "get us states"
	@handler GetUsStates
	get /us_states (EmptyRequest) returns (GetUsStatesResponse)

	@doc "get us city"
	@handler GetUsCities
	get /us_cities (GetUsCitiesRequest) returns (GetUsCitiesResponse)
}

// ============== common end =============
// ============== user start =============
@server(
    desc: "admin-api service"
	version: v1
    group: user
	prefix:  /api/v1
    tags: user
)
service admin-api {
	@doc "login"
	@handler Login
	post /user/login (UserLoginRequest) returns (UserLoginResponse)

	@doc "refresh"
	@handler RefreshToken
	post /user/refresh (UserRefreshTokenRequest) returns (UserRefreshTokenResponse)

	@doc "reset password"
	@handler ResetPassword
	post /user/reset_password (UserResetPasswordRequest) returns (UserLoginResponse)
}

@server(
    desc: "admin-api service"
    version: v1
    group: user
	prefix:     /api/v1
	middleware: AuthMiddleware
    tags: user
)
service admin-api {
	@doc "info"
	@handler Info
	get /user/info (EmptyRequest) returns (UserInfoResponse)

	@doc "edit profile"
	@handler EditProfile
	put /user/profile (UserEditProfileRequest) returns (UserInfoResponse)
}

// ============== user end =============
// ============== organization service start ============
@server(
    desc: "admin-api service"
    version: v1
    group: organization
	prefix:     /api/v1
	middleware: AuthMiddleware
    tags: organization
)
service admin-api {
	@doc "detail"
	@handler OrganizationDetail
	get /organization/:id (PathIdRequest) returns (OrganizationEntity)

	@doc "page"
	@handler OrganizationPage
	post /organization/page (OrganizationPageRequest) returns (OrganizationPageResponse)

	@doc "lender create"
	@handler OrganizationCreateLender
	post /organization/lender (OrganizationCreateLenderRequest) returns (OrganizationEntity)

	@doc "lender update"
	@handler OrganizationUpdateLender
	put /organization/lender/:id (OrganizationUpdateLenderRequest) returns (OrganizationEntity)

	@doc "delete"
	@handler OrganizationDelete
	delete /organization/:id (PathIdRequest) returns (EmptyResponse)

	@doc "switch status"
	@handler OrganizationSwitchStatus
	patch /organization/:id/status (OrganizationSwitchStatusRequest) returns (EmptyResponse)

	@doc "select option"
	@handler OrganizationSelectOption
	get /organization/select_options (OrganizationSelectOptionRequest) returns (OrganizationOptionResponse)
    // @doc "all lender"
    // @handler OrganizationLenders
    // get /organization/lenders (EmptyRequest) returns (OrganizationOptionResponse)
}

// ============= organization service end ============
// ============== organization user start ============
@server(
    desc: "admin-api service"
    version: v1
    group: organization_user
	prefix:     /api/v1
	middleware: AuthMiddleware
    tags: organization_user
)
service admin-api {
	@doc "page"
	@handler OrganizationUserPage
	post /organization_user/page (OrganizationUserPageRequest) returns (OrganizationUserPageResponse)

	@doc "detail"
	@handler OrganizationUserDetail
	get /organization_user/:id (PathIdRequest) returns (OrganizationUserDetailResponse)

	@doc "create"
	@handler OrganizationUserCreate
	post /organization_user (OrganizationUserCreateRequest) returns (OrganizationUserDetailResponse)

	@doc "update"
	@handler OrganizationUserUpdate
	put /organization_user/:id (OrganizationUserUpdateRequest) returns (OrganizationUserDetailResponse)

	@doc "delete"
	@handler OrganizationUserDelete
	delete /organization_user/:id (PathIdRequest) returns (EmptyResponse)

	@doc "switch status"
	@handler OrganizationUserSwitchStatus
	patch /organization_user/:id/status (OrganizationUserSwitchStatusRequest) returns (EmptyResponse)
}

// ============== organization user end ============
// ============== api start ============
@server(
    desc: "admin-api service"
    version: v1
    group: api
	prefix:     /api/v1
	middleware: AuthMiddleware
    tags: api
)
service admin-api {
	@doc "detail"
	@handler Detail
	get /api/:id (ApiDetailRequest) returns (ApiEntity)

	@doc "tree"
	@handler Tree
	get /api/tree (ApiTreeRequest) returns (ApiTreeResponse)

	@doc "create"
	@handler Create
	post /api (ApiCreateRequest) returns (ApiEntity)

	@doc "update"
	@handler Update
	put /api/:id (ApiUpdateRequest) returns (ApiEntity)

	@doc "delete"
	@handler Delete
	delete /api/:id (ApiDeleteRequest) returns (EmptyResponse)
}

// ============= api end =============
// ============== resource start ============
@server(
    desc: "admin-api service"
    version: v1
    group: resource
	prefix:     /api/v1
	middleware: AuthMiddleware
    tags: resource
)
service admin-api {
	@doc "detail"
	@handler ResourceDetail
	get /resource/:id (ResourceDetailRequest) returns (ResourceEntity)

	@doc "tree"
	@handler ResourceTree
	get /resource/tree (ResourceTreeRequest) returns (ResourceTreeResponse)

	@doc "create"
	@handler ResourceCreate
	post /resource (ResourceCreateRequest) returns (ResourceEntity)

	@doc "update"
	@handler ResourceUpdate
	put /resource/:id (ResourceUpdateRequest) returns (ResourceEntity)

	@doc "delete"
	@handler ResourceDelete
	delete /resource/:id (ResourceDeleteRequest) returns (EmptyResponse)
}

// ============== resource end =============
// ============== role start ============
@server(
    desc: "admin-api service"
    version: v1
    group: role
	prefix:     /api/v1
	middleware: AuthMiddleware
    tags: role
)
service admin-api {
	@doc "detail"
	@handler RoleDetail
	get /role/:id (PathIdRequest) returns (RoleEntity)

	@doc "page"
	@handler RolePage
	post /role/page (RolePageRequest) returns (RolePageResponse)

	@doc "all"
	@handler RoleAll
	get /role/all (EmptyRequest) returns (RoleAllResponse)

	@doc "create"
	@handler RoleCreate
	post /role (RoleCreateRequest) returns (RoleEntity)

	@doc "update"
	@handler RoleUpdate
	put /role/:id (RoleUpdateRequest) returns (RoleEntity)

	@doc "delete"
	@handler RoleDelete
	delete /role/:id (PathIdRequest) returns (EmptyResponse)

	@doc "switch status"
	@handler RoleSwitchStatus
	patch /role/:id/status (RoleSwitchStatusRequest) returns (EmptyResponse)
}

// ============== role end =============
// ============= storage start ============
@server(
    desc: "storage service"
    version: v1
    group: storage
	prefix:     /api/v1
	middleware: AuthMiddleware
    tags: storage
)
service admin-api {
	@doc "create aws s3 presign url"
	@handler CreateAwsS3PresignUrl
	post /storage/presign_url (S3PresignUrlCreateRequest) returns (S3PresignUrlCreateResponse)
}

// ============= storage end =============
// ============== base template start ============
@server(
    desc: "base template service"
    version: v1
	prefix:     /api/v1
    group: base_template
	middleware: AuthMiddleware
    tags: base_template
)
service admin-api {
	@doc "Create"
	@handler BaseTemplateCreate
	post /base_template (BaseTemplateCreateRequest) returns (BaseTemplateDetailResponse)

	@doc "Reset"
	@handler BaseTemplateReset
	post /base_template/:id/reset (PathIdRequest) returns (BaseTemplateDetailResponse)

	@doc "Update"
	@handler BaseTemplateUpdate
	put /base_template/:id (BaseTemplateUpdateRequest) returns (BaseTemplateDetailResponse)

	@doc "Detail"
	@handler BaseTemplateDetail
	get /base_template/:id (PathIdRequest) returns (BaseTemplateDetailResponse)

	@doc "page"
	@handler BaseTemplatePage
	post /base_template/page (BaseTemplatePageRequest) returns (BaseTemplatePageResponse)

	@doc "Switch status"
	@handler BaseTemplateSwitchStatus
	patch /base_template/:id/status (BaseTemplateSwitchStatusRequest) returns (EmptyResponse)

	@doc "Delete"
	@handler BaseTemplateDelete
	delete /base_template/:id (PathIdRequest) returns (EmptyResponse)

	@doc "Preview"
	@handler BaseTemplatePreview
	post /base_template/preview (BaseTemplatePreviewRequest) returns (BaseTemplatePreviewResponse)
}

// ============== base template end ============
// ============== loan service end ============
@server(
    desc: "loan service"
    version: v1
	prefix:     /api/v1
    group: loan
	middleware: AuthMiddleware
    tags: loan
)
service admin-api {
	@doc "page"
	@handler LoanPage
	post /loan/page (LoanPageRequest) returns (LoanPageResponse)

	@doc "detail"
	@handler LoanDetail
	get /loan/:id (PathIdRequest) returns (LoanDetailResponse)

	@doc "reassign"
	@handler LoanReassign
	post /loan/:id/reassign (LoanReassignRequest) returns (EmptyResponse)

	@doc "lender companies list"
	@handler LenderCompanies
	get /loan/lender_companies (EmptyRequest) returns (LoanLenderCompanyResponse)
}

    // ============== loan service end ============
