syntax = "v1"

info(
    title: "role-api"
    desc: "role-api http service description"
    version: "v1"
)

import "resource.api"
import "common.api"


type RoleOrganizationUserEntity {
    Id int64 `json:"id"`
    OrganizationId int64 `json:"organization_id"`
    UserId int64 `json:"user_id"`
    Status string `json:"status"`
    FirstName string `json:"first_name"`
    MidName string `json:"mid_name"`
    LastName string `json:"last_name"`
    FullName string `json:"full_name"`
    Phone string `json:"phone"`
    Remark string `json:"remark"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    Email string `json:"email"`
}

type RoleEntity {
    Id int64 `json:"id"`
    OrganizationId int64 `json:"organization_id"`
    Name string `json:"name"`
    Description string `json:"description"`
    Type string `json:"type"`
    Status string `json:"status"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    Resources []*ResourceEntity `json:"resources"`
    OrganizationUsers []*RoleOrganizationUserEntity `json:"organization_users"`
}

// page
type RolePageRequest {
    BasePageRequest
    Filter BasePageFilter `json:"filter"`
    Sort BasePageSort `json:"sort"`
}


type RolePageResponse {
    Page int64 `json:"page"`
    Limit int64 `json:"limit"`
    Total int64 `json:"total"`
    TotalPage int64 `json:"total_page"`
    List []RoleEntity `json:"list"`
}

type RoleAndResourceRelation {
    RoleId int64 `json:"role_id,optional" validate:"min=0"`
    ResourceId int64 `json:"resource_id" validate:"min=1"`
    DataScope string `json:"data_scope" validate:"oneof=All Own"`
}

//  create
type RoleCreateRequest {
    Name string `json:"name" validate:"required,min=2,max=100,ne='admin'"`
    Description string `json:"description,optional" validate:"max=255"`
    Status string `json:"status" validate:"required,oneof=Active Disabled"`
    Resources []RoleAndResourceRelation `json:"resources,optional" validate:"dive"`
}
//  update
type RoleUpdateRequest {
    Id int64 `path:"id" validate:"required,gt=0"`
    Name string `json:"name" validate:"required,min=2,max=100,ne='admin'"`
    Description string `json:"description,optional" validate:"max=255"`
    Status string `json:"status" validate:"required,oneof=Active Disabled"`
    Resources []RoleAndResourceRelation `json:"resources,optional" validate:"dive"`
}
//  delete
type RoleDeleteRequest {
    Id int64 `path:"id" validate:"required,gt=0"`
}

// switch status
type RoleSwitchStatusRequest {
    Id int64 `path:"id" validate:"required,gt=0"`
    Status string `json:"status" validate:"required,oneof=Active Disabled"`
}

// all
type RoleAllResponse {
    List []*RoleEntity `json:"list"`
}

// AssignOrganizationUser
type RoleAssignOrganizationUserRequest {
    Id int64 `path:"id" validate:"required,gt=0"`
    OrganizationUserIds []int64 `json:"organization_user_ids,optional" validate:"dive,gt=0"`
}
