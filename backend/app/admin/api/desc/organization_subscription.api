syntax = "v1"

info(
    title: "organization-subscription-api"
    desc: "organization subscription management http service description"
    version: "v1"
)

import "common.api"
import "organization.api"
import "pricing_plan.api"

// Entity
type (
    OrganizationSubscriptionEntity {
        Id int64 `json:"id"`
        Code string `json:"code"`
        OrganizationId int64 `json:"organization_id"`
        PricingPlanId int64 `json:"pricing_plan_id"`
        PricingPlanPolicyId int64 `json:"pricing_plan_policy_id"`
        Status string `json:"status"`
        ExpireDate string `json:"expire_date"`
        OriginalAmount float64 `json:"original_amount"`
        ActualAmount float64 `json:"actual_amount"`
        IsAutoRenew bool `json:"is_auto_renew"`
        Organziation *OrganizationEntity `json:"organziation,omitempty"`
        PricingPlan *PricingPlanEntity `json:"pricing_plan,omitempty"`
        CreatedAt string `json:"created_at"`
        UpdatedAt string `json:"updated_at"`
    }

    OrganizationSubscriptionPageEntity {
        Id int64 `json:"id"`
        Code string `json:"code"`
        OrganizationName string `json:"organization_name"`
        PricingPlanName string `json:"pricing_plan_name"`
        Status string `json:"status"`
        ExpireDate string `json:"expire_date"`
        OriginalAmount float64 `json:"original_amount"`
        ActualAmount float64 `json:"actual_amount"`
        IsAutoRenew bool `json:"is_auto_renew"`
        CreatedAt string `json:"created_at"`
        UpdatedAt string `json:"updated_at"`
    }
)

// Create
type (
    OrganizationSubscriptionCreateRequest {
        OrganizationId int64 `json:"organization_id" validate:"required,gt=0"`
        PricingPlanId int64 `json:"pricing_plan_id" validate:"required,gt=0"`
        PricingPlanPolicyId int64 `json:"pricing_plan_policy_id" validate:"required,gt=0"`
        Type string `json:"type" validate:"required,oneof=Borrower Lender Admin"`
    }

    OrganizationSubscriptionDetailResponse {
        OrganizationSubscriptionEntity
    }
)

// Renew
type OrganizationSubscriptionRenewRequest {
    Id int64 `path:"id" validate:"required,gt=0"`
    ExpireDate string `json:"expire_date" validate:"required,datetime=01/02/2006"`
}

// Update Expire Date
type OrganizationSubscriptionUpdateExpireDateRequest {
    Id int64 `path:"id" validate:"required,gt=0"`
    ExpireDate string `json:"expire_date" validate:"required"`
}

// Switch Status
type OrganizationSubscriptionSwitchStatusRequest {
    Id int64 `path:"id" validate:"required,gt=0"`
    Status string `json:"status" validate:"required,oneof=Trialing Active Expiring Expired Suspended"`
}

// Page
type (
    OrganizationSubscriptionFilter {
        OrganizationId int64 `json:"organization_id,optional"`
        PricingPlanId int64 `json:"pricing_plan_id,optional"`
        Status string `json:"status,optional" validate:"omitempty,oneof=Trialing Active Expiring Expired Suspended"`
    }

    OrganizationSubscriptionPageRequest {
        BasePageRequest
        Filter *OrganizationSubscriptionFilter `json:"filter,optional"`
        Sort *BasePageSort `json:"sort,optional"`
    }

    OrganizationSubscriptionPageResponse {
        BasePageResponse
        List []*OrganizationSubscriptionPageEntity `json:"list"`
    }
)
