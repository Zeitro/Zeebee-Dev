syntax = "v1"

info(
    title: "admin-user-api"
    desc: "user-api http service description"
    author: "Wei Zeng"
    email: "wei@yeelee-capital.com"
    version: "v1"
)

import "organization.api"
import "role.api"

type UserInfo {
    Id int64 `json:"id"`
    Email string `json:"email"`
    FirstName string `json:"first_name"`
    LastName string `json:"last_name"`
    FullName string `json:"full_name"`
    Phone string `json:"phone"`
    Status string `json:"status"`
    OrganizationId int64 `json:"organization_id"`
    OrganizationName string `json:"organization_name"`
    Organizations []*UserInfoOrganizationEntity `json:"organizations"`
}
type UserEntity {
    Id int64 `json:"id"`
    Email string `json:"email"`
    Status string `json:"status"`
    Type string `json:"type"`
    FirstName string `json:"first_name"`
    MidName string `json:"mid_name"`
    LastName string `json:"last_name"`
    FullName string `json:"full_name"`
    DefaultOrganizationId int64 `json:"default_organization_id"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    PivotOrganizationStatus string `json:"pivot_organization_status,omitempty"`
    Roles []*RoleEntity `json:"roles"`
}

// login
type (
    UserLoginRequest {
        Email string `json:"email" validate:"required,email"`
        Password string `json:"password" validate:"required,min=8,max=32"`
    }

    UserLoginResponse {
        AccessToken string `json:"access_token"`
        AccessTokenExpire int64 `json:"access_token_expire"`
        RefreshToken string `json:"refresh_token"`
        RefreshTokenExpire int64 `json:"refresh_token_expire"`
    }
)

// refresh token
type (
    UserRefreshTokenRequest {
        RefreshToken string `json:"refresh_token" validate:"required"`
    }
    UserRefreshTokenResponse {
        AccessToken string `json:"access_token"`
        AccessTokenExpire int64 `json:"access_token_expire"`
    }
)

// user info
type (
    UserInfoResponse {
        UserInfo
    }
)

// reset password
type (
    UserResetPasswordRequest {
        Email string `json:"email" validate:"required,email"`
        Password string `json:"password" validate:"required,min=8,max=32,password"`
        ComfiredPassword string `json:"comfired_password" validate:"required,eqfield=Password"`
        Code string `json:"code" validate:"required,len=10"`
    }
)

// edit profile
type (
    UserEditProfileRequest {
        FirstName string `json:"first_name" validate:"required,min=2,max=100"`
        LastName string `json:"last_name" validate:"required,min=2,max=100"`
    }
)
// admin user
// page
type (
    UserPageRequest {
        Page int64 `json:"page,optional"`
        Limit int64 `json:"limit,optional"`
        Filter *UserPageRequestFilter `json:"filter,optional"`
        Sorter *UserPageRequestSorter `json:"sorter,optional"`
    }
    UserPageResponse {
        Page int64 `json:"page"`
        Limit int64 `json:"limit"`
        Total int64 `json:"total"`
        TotalPage int64 `json:"total_page"`
        List []*UserEntity `json:"list"`
    }

    UserPageRequestFilter {
        Keyword string `json:"keyword,optional"`
    }

    UserPageRequestSorter {
        Column string `json:"column,optional"`
        Sort string `json:"sort,optional"`
    }
)
// create
type (
    UserCreateRequest {
        Email string `json:"email" validate:"required,email"`
        Password string `json:"password" validate:"required,min=8,max=32,password"`
        FullName string `json:"full_name" validate:"required,min=2,max=200"`
        Phone string `json:"phone" validate:"required,min=6,max=20"`
        RoleIds []int64 `json:"role_ids,optional"`
    }
    UserCreateResponse {
        UserEntity
    }
)
// update
type (
    UserUpdateRequest {
        Id int64 `path:"id" validate:"required"`
        FullName string `json:"full_name" validate:"required,min=2,max=200"`
        Phone string `json:"phone" validate:"required,min=6,max=20"`
        Password string `json:"password,optional" validate:"omitempty,password"`
        RoleIds []int64 `json:"role_ids,optional"`
    }
    UserUpdateResponse {
        UserEntity
    }
)

// detail
type (
    UserDetailResponse {
        UserEntity
    }
)

// update status
type (
    UserSwitchStatusRequest {
        Id int64 `path:"id" validate:"required"`
        Status string `json:"status" validate:"required,oneof=Active Disabled"`
    }
)

