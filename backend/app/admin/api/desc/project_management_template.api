import "../../../../domains/zeebee/api/entity.api"
import "common.api"

type ProjectManagementTemplatePageRequest {
    Page  int64 `json:"page,default=1"`
    Limit int64 `json:"limit,default=20" validate:"gte=1,lte=100"`
    Filter BasePageFilter `json:"filer"`
    Sorter BasePageSort `json:"sorter"`
}

type ProjectManagementTemplatePageResponse {
    Total     int64                              `json:"total"`
    Page      int64                              `json:"page"`
    Limit     int64                              `json:"limit"`
    TotalPage int64                              `json:"total_page"`
    List      []*ProjectManagementTemplateEntity `json:"list"`
}

type ProjectManagementTemplateCreateRequest {
    Name        string `json:"name" validate:"required,max=100"`
    Description string `json:"description,optional" validate:"max=500"`
    Status      string `json:"status,optional,options=Active|Disabled" validate:"omitempty,oneof=Active Disabled"`
    SortOrder   int    `json:"sort_order,optional" validate:"gte=0"`
    ProjectType string `json:"project_type" validate:"required,oneof=Ordinary Planned"`
    StartAt     string `json:"start_at,optional" validate:"required_if=ProjectType Planned,omitempty,datetime=01/02/2006"`
    EndAt       string `json:"end_at,optional" validate:"required_if=ProjectType Planned,omitempty,datetime=01/02/2006"`
    PeriodValue int    `json:"period_value,optional" validate:"required_if=ProjectType Planned,gt=0"`
    PeriodUnit  string `json:"period_unit,optional,options=Day|Week|Month|" validate:"required_if=ProjectType Planned,omitempty,oneof=Day Week Month ''"`
}

type ProjectManagementTemplateUpdateRequest {
    Id          int64                                  `path:"id" validate:"required,gt=0"`
    Name        string                                 `json:"name" validate:"required,max=100"`
    Description string                                 `json:"description,optional" validate:"max=500"`
    Status      string                                 `json:"status,optional,options=Active|Disabled" validate:"omitempty,oneof=Active Disabled"`
    SortOrder   int                                    `json:"sort_order,optional" validate:"gte=0"`
    ProjectType string `json:"project_type" validate:"required,oneof=Ordinary Planned"`
    StartAt     string                                 `json:"start_at,optional" validate:"required_if=ProjectType Planned,omitempty,datetime=01/02/2006"`
    EndAt       string                                 `json:"end_at,optional" validate:"required_if=ProjectType Planned,omitempty,datetime=01/02/2006"`
    PeriodValue int                                    `json:"period_value,optional" validate:"required_if=ProjectType Planned,gt=0"`
    PeriodUnit  string                                 `json:"period_unit,optional,options=Day|Week|Month|" validate:"required_if=ProjectType Planned,omitempty,oneof=Day Week Month ''"`
    Stages      []*ProjectManagementTemplateStageInput `json:"stages" validate:"required,min=2,dive"`
}

type ProjectManagementTemplateStageInput {
    Id          int64  `json:"id,optional" validate:"gte=0"`
    Name        string `json:"name" validate:"required,max=100"`
    Description string `json:"description,optional" validate:"max=500"`
    Phase       string `json:"phase" validate:"required,oneof=Pending InProgress Finished"`
    Color       string `json:"color,optional" validate:"max=32"`
    SortOrder   int    `json:"sort_order,optional" validate:"gte=0"`
}

type ProjectManagementTemplateStatusRequest {
    Id     int64  `path:"id" validate:"required,gt=0"`
    Status string `json:"status" validate:"required,oneof=Active Disabled"`
}

type ProjectManagementTemplateDefaultsRequest {
    Id          int64  `path:"id" validate:"required,gt=0"`
    ProjectType string `json:"project_type" validate:"required,oneof=Ordinary Planned"`
    StartAt     string `json:"start_at,optional" validate:"omitempty,datetime=01/02/2006"`
    PeriodValue int    `json:"period_value,optional" validate:"gte=0"`
    PeriodUnit  string `json:"period_unit,optional,options=Day|Week|Month" validate:"omitempty,oneof=Day Week Month"`
}

@server (
    desc: "admin project management template"
    version: v1
    group: project_management_template
    prefix: /api/v1
    middleware: AuthMiddleware
    tags: project_management_template
)
service admin-api {
    @doc "page"
    @handler ProjectManagementTemplatePage
    post /project_management/template/page (ProjectManagementTemplatePageRequest) returns (ProjectManagementTemplatePageResponse)

    @doc "create"
    @handler ProjectManagementTemplateCreate
    post /project_management/template (ProjectManagementTemplateCreateRequest) returns (ProjectManagementTemplateEntity)

    @doc "update"
    @handler ProjectManagementTemplateUpdate
    put /project_management/template/:id (ProjectManagementTemplateUpdateRequest) returns (ProjectManagementTemplateEntity)

    @doc "delete"
    @handler ProjectManagementTemplateDelete
    delete /project_management/template/:id (PathIdRequest) returns (EmptyResponse)

    @doc "status"
    @handler ProjectManagementTemplateStatus
    put /project_management/template/:id/status (ProjectManagementTemplateStatusRequest) returns (ProjectManagementTemplateEntity)

    @doc "set default template"
    @handler ProjectManagementTemplateDefaults
    put /project_management/template/:id/default (ProjectManagementTemplateDefaultsRequest) returns (EmptyResponse)

    @doc "detail"
    @handler ProjectManagementTemplateDetail
    get /project_management/template/:id (PathIdRequest) returns (ProjectManagementTemplateEntity)
}
