syntax = "v1"

info (
	title:  "lender-api http service"
	desc:   "lender-api http service description"
	author: "Wei Zeng"
	email:  "wei@yeelee-capital.com"
)

import "desc/user.api"
import "desc/common.api"
import "desc/us_geography.api"
import "desc/loan.api"
import "desc/storage.api"
import "desc/loan_document.api"
import "desc/resource.api"
import "desc/role.api"
import "desc/organization_user.api"
import "desc/organization.api"
import "desc/organization_template.api"

type (
	EmptyRequest  {}
	EmptyResponse  {}
)

type PathIdRequest {
	id int64 `path:"id" validate:"required,gt=0"`
}

// ============== common =============
@server (
	desc:    "lender-api service"
	version: v1
	group:   common
	prefix:  /api/v1
	tags:    common
)
service lender-api {
	@doc "select options"
	@handler SelectOptions
	get /select_options (GetSelectOptionRequest) returns (GetSelectOptionResponse)

	@doc "get us states"
	@handler GetUsStates
	get /us_states (EmptyRequest) returns (GetUsStatesResponse)

	@doc "get us city"
	@handler GetUsCities
	get /us_cities (GetUsCitiesRequest) returns (GetUsCitiesResponse)
}

// ============== user =============
@server (
	desc:    "lender-api service"
	version: v1
	group:   user
	prefix:  /api/v1
	tags:    user
)
service lender-api {
	@doc "register"
	@handler Register
	post /user/register (UserRegisterRequest) returns (EmptyResponse)

	@doc "login"
	@handler Login
	post /user/login (UserLoginRequest) returns (UserJwtResponse)

	@doc "refresh"
	@handler RefreshToken
	post /user/refresh (UserRefreshTokenRequest) returns (UserJwtResponse)

	@doc "verify email"
	@handler VerifyEmail
	post /user/verify_email (UserVerifyEmailRequest) returns (UserJwtResponse)

	@doc "send verify email"
	@handler SendVerifyEmail
	post /user/send_verify_email (UserSendVerifyEmailRequest) returns (EmptyResponse)

	@doc "reset password"
	@handler ResetPassword
	post /user/reset_password (UserResetPasswordRequest) returns (UserJwtResponse)

	@doc "send reset password email"
	@handler SendResetPassword
	post /user/send_reset_password (UserSendResetPasswordEmailRequest) returns (EmptyResponse)
}

@server (
	desc:       "lender-api service"
	version:    v1
	group:      user
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       user
)
service lender-api {
	@doc "info"
	@handler Info
	get /user/info (EmptyRequest) returns (UserInfoResponse)

	@doc "switch organization"
	@handler SwitchOrganization
	post /user/switch_organization (UserSwitchOrganizationRequest) returns (UserJwtResponse)
}

// ============== loan =============
@server (
	desc:       "loan service"
	version:    v1
	group:      loan
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       loan
)
service lender-api {
	@doc "detail"
	@handler Detail
	get /loan/:id (LoanDetailRequest) returns (LoanDetailResponse)

	@doc "page"
	@handler Page
	post /loan/page (LoanPageRequest) returns (LoanPageResponse)

	@doc "update"
	@handler update
	put /loan/:id (LoanUpdateRequest) returns (LoanUpdateResponse)

	@doc "update loan stage"
	@handler UpdateStage
	patch /loan/:id/stage (UpdateLoanStageRequest) returns (EmptyResponse)

	@doc "update loan pending status"
	@handler UpdatePendingStatus
	patch /loan/:id/pending_status (UpdateLoanPendingStatusRequest) returns (EmptyResponse)

	@doc "reveiw loan pending status"
	@handler ReviewPendingStatus
	post /loan/:id/review_pending_status (ReviewLoanPendingStatusRequest) returns (EmptyResponse)

	@doc "loan documents opts"
	@handler LoanDocumentsOpts
	get /loan/:id/loan_documents_opts (PathIdRequest) returns (LoanDocumentOptResponse)
}

// ============== loan document =============
@server (
	desc:       "loan document service"
	version:    v1
	group:      loan_document
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       loan_document
)
service lender-api {
	@doc "create loan document"
	@handler CreateLoanDocument
	post /loan_document (LoanDocumentCreateRequest) returns (LoanDocumentCreateResponse)

	@doc "delete loan document request"
	@handler DeleteLoanDocumentRequest
	delete /loan_document/:id/request (PathIdRequest) returns (EmptyResponse)

	@doc "send loan document requests"
	@handler SendLoanDocumentRequests
	post /loan_document/send_requests (LoanDocumentSendRequestsRequest) returns (EmptyResponse)

	@doc "update comment"
	@handler UpdateComment
	patch /loan_document/:id/comment (LoanDocumentUpdateCommentRequest) returns (EmptyResponse)

	@doc "add files"
	@handler AddFiles
	post /loan_document/:id/files (LoanDocumentAddFilesRequest) returns (EmptyResponse)
}

// =============== file ==============
@server (
	desc:       "file service"
	version:    v1
	group:      file
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       file
)
service lender-api {
	@doc "delete"
	@handler Delete
	delete /file/:id (PathIdRequest) returns (EmptyResponse)
}

// =============== storage ==============
@server (
	desc:       "storage service"
	version:    v1
	group:      storage
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       storage
)
service lender-api {
	@doc "create aws s3 presign url"
	@handler CreateAwsS3PresignUrl
	post /storage/presign_url (S3PresignUrlCreateRequest) returns (S3PresignUrlCreateResponse)
}

// ============== role =============
@server (
	desc:       "lender-api service"
	version:    v1
	group:      role
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       role
)
service lender-api {
	@doc "detail"
	@handler RoleDetail
	get /role/:id (PathIdRequest) returns (RoleEntity)

	@doc "page"
	@handler RolePage
	post /role/page (RolePageRequest) returns (RolePageResponse)

	@doc "all"
	@handler RoleAll
	get /role/all (EmptyRequest) returns (RoleAllResponse)

	@doc "create"
	@handler RoleCreate
	post /role (RoleCreateRequest) returns (RoleEntity)

	@doc "update"
	@handler RoleUpdate
	put /role/:id (RoleUpdateRequest) returns (RoleEntity)

	@doc "delete"
	@handler RoleDelete
	delete /role/:id (PathIdRequest) returns (EmptyResponse)

	@doc "update status"
	@handler RoleUpdateStatus
	patch /role/:id/status (RoleUpdateStatusRequest) returns (EmptyResponse)
}

// ============== organization user start =============
@server (
	desc:    "lender-api service"
	version: v1
	group:   organization_user
	prefix:  /api/v1
	tags:    organization_user
)
service lender-api {
	@doc "accept invitation"
	@handler OrganizationUserAcceptInvitation
	post /organization_user/accept_invitation (OrganizationUserAcceptInvitationRequest) returns (UserJwtResponse)
}

@server (
	desc:       "lender-api service"
	version:    v1
	group:      organization_user
	prefix:     /api/v1
	middleware: AuthMiddleware
	tags:       organization_user
)
service lender-api {
	@doc "detail"
	@handler OrganizationUserDetail
	get /organization_user/:id (PathIdRequest) returns (OrganizationUserEntity)

	@doc "page"
	@handler OrganizationUserPage
	post /organization_user/page (OrganizationUserPageRequest) returns (OrganizationUserPageResponse)

	@doc "all"
	@handler OrganizationUserAll
	get /organization_user/all (EmptyRequest) returns (OrganizationUserAllResponse)

	@doc "create"
	@handler OrganizationUserCreate
	post /organization_user (OrganizationUserCreateRequest) returns (OrganizationUserEntity)

	@doc "update"
	@handler OrganizationUserUpdate
	put /organization_user/:id (OrganizationUserUpdateRequest) returns (OrganizationUserEntity)

	@doc "delete"
	@handler OrganizationUserDelete
	delete /organization_user/:id (PathIdRequest) returns (EmptyResponse)

	@doc "switch status"
	@handler OrganizationUserSwitchStatus
	patch /organization_user/:id/status (OrganizationUserSwitchStatusRequest) returns (EmptyResponse)

	@doc "assign roles"
	@handler OrganizationUserAssignRoles
	post /organization_user/:id/assign_roles (OrganizationUserAssignRolesRequest) returns (EmptyResponse)

	@doc "send email"
	@handler OrganizationUserSendEmail
	post /organization_user/:id/send_email (PathIdRequest) returns (EmptyResponse)
}

// ============== organization user end =============
// ============== organization service start =============
@server (
	desc:       "lender-api service"
	version:    v1
	group:      organization
	prefix:     /api/v1
	tags:       organization
	middleware: AuthMiddleware
)
service lender-api {
	@doc "profile"
	@handler OrganizationProfile
	get /organization/profile (EmptyRequest) returns (OrganizationEntity)

	@doc "update profile"
	@handler OrganizationUpdateProfile
	put /organization/profile (OrganizationUpdateProfileRequest) returns (OrganizationEntity)

	@doc "create"
	@handler OrganizationCreate
	post /organization (OrganizationCreateRequest) returns (OrganizationEntity)
}

// ============== organization service end =============
// ============== organization template service start ============
@server(
	desc: "organization template service"
	version: v1
	prefix:     /api/v1
	group: organization_template
	middleware: AuthMiddleware
	tags: organization_template
)
service lender-api {
	@doc "Update"
	@handler OrganizationTemplateUpdate
	put /organization_template/:id (OrganizationTemplateUpdateRequest) returns (OrganizationTemplateDetailResponse)

	@doc "Detail"
	@handler OrganizationTemplateDetail
	get /organization_template/:id (PathIdRequest) returns (OrganizationTemplateDetailResponse)

	@doc "Get Detail by purpose"
	@handler OrganizationTemplateDetailByPurpose
	get /organization_template/detail_by_purpose (OrganizationTemplateDetailByPurposeRequest) returns (OrganizationTemplateDetailResponse)

	@doc "page"
	@handler OrganizationTemplatePage
	post /organization_template/page (OrganizationTemplatePageRequest) returns (OrganizationTemplatePageResponse)

	@doc "Preview"
	@handler OrganizationTemplatePreview
	post /organization_template/preview (OrganizationTemplatePreviewRequest) returns (OrganizationTemplatePreviewResponse)

	@doc "Reset"
	@handler OrganizationTemplateReset
	post /organization_template/:id/reset (PathIdRequest) returns (EmptyResponse)
}

	// ============== organization template service end ============
