syntax = "v1"

info(
    title: "lender-loan-api"
    desc: "loan-api http service description"
    version: "v1"
)
import "address.api"
import "loan_applicant.api"
import "loan_third_service.api"
import "loan_experience.api"
import "loan_borrower.api"
import "loan_demographic.api"
import "file.api"
import "loan_experience.api"
import "loan_document.api"
import "loan_property.api"

