syntax = "v1"

info(
    title: "organization-api"
    desc: "organization-api http service description"
    version: "v1"
)

import "address.api"
import "organization_email.api"
import "common.api"

type (
    UserInfoOrganizationEntity {
        Id int64 `json:"id"`
        Name string `json:"name"`
        Status string `json:"status"`
        IsDefault bool `json:"is_default"`
    }
)

type OrganizationEntity {
    Id int64 `json:"id"`
    Name string `json:"name"`
    Status string `json:"status"`
    OwnerId int64 `json:"owner_id"`
    Address AddressEntity `json:"address"`
    ContactEmail string `json:"contact_email"`
    ContactPhone string `json:"contact_phone"`
    ContactName string `json:"contact_name"`
    OwnerType string `json:"owner_type"`
    Type string `json:"type"`
    Logo string `json:"logo"`
    Website string `json:"website"`
    Tagline string `json:"tagline"`
    Metadata *OrganizationMetadataEntity `json:"metadata"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`

    OrganizationEmails []*OrganizationEmailEntity `json:"organization_emails"`
}

type OrganizationMetadataEntity {
    Lender *OrganizationLenderMetadataEntity `json:"lender,omitempty"`
}
type (
    OrganizationLenderMetadataEntity {
        LoanAmountRange RangeFloat64 `json:"loan_amount_range"`
        LoanTermRange RangeInt `json:"loan_term_range"`
        LoanTateRange RangeFloat64 `json:"loan_tate_range"`
        LoanPointRange RangeFloat64 `json:"loan_point_range"`
    }
)
// update profile -- request
type OrganizationUpdateProfileRequest {
    ContactEmail string `json:"contact_email" validate:"required,email"`
    ContactPhone string `json:"contact_phone" validate:"required,min=8,max=20"`
    ContactName string `json:"contact_name" validate:"required,min=2,max=50"`
    Logo string `json:"logo,optional"`
    Website string `json:"website,optional"`
    Tagline string `json:"tagline,optional"`
    Metadata *OrganizationMetadataEntity `json:"metadata,optional"`
}