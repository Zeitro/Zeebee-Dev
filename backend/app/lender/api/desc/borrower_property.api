syntax = "v1"

info(
    title: "lender-loan-property-api"
    desc: "lender-loan-property-api http service description"
    version: "v1"
)

import "address.api"


type BorrowerPropertyEntity {
    Id int64 `json:"id"`
    PropertyType string `json:"property_type"`
    TotalAmount float64 `json:"total_amount"`
    Unit int32 `json:"unit"`
    LivingAreaSqft float32 `json:"living_area_sqft"`
    LotAreaSqft float32 `json:"lot_area_sqft,optional"`
    Bedrooms int32 `json:"bedrooms"`
    Bathrooms int32 `json:"bathrooms"`
    Address *AddressEntity `json:"address"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    LoanCount int32 `json:"loan_count"`
}