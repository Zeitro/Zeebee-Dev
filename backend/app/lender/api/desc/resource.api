syntax = "v1"

info(
    title: "resource-api"
    desc: "resource-api http service description"
    version: "v1"
)

type ResourceTreeEntity {
    Id int64 `json:"id"`
    ParentId int64 `json:"parent_id"`
    Type string `json:"type"`
    ResourceType string `json:"resource_type"`
    Name string `json:"name"`
    Path string `json:"path"`
    Icon string `json:"icon"`
    Tag string `json:"tag"`
    IsShow bool `json:"is_show"`
    Status string `json:"status"`
    SortOrder int32 `json:"sort_order"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    Children []*ResourceTreeEntity `json:"children,omitempty"`
}

type ResourceEntity {
    Id int64 `json:"id"`
    ParentId int64 `json:"parent_id"`
    Type string `json:"type"`
    ResourceType string `json:"resource_type"`
    Name string `json:"name"`
    Path string `json:"path"`
    Icon string `json:"icon"`
    Tag string `json:"tag"`
    IsShow bool `json:"is_show"`
    Status string `json:"status"`
    SortOrder int32 `json:"sort_order"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    PivotRoleDataScope string `json:"pivot_role_data_scope,omitempty"`
}

type ResourceTreeRequest {
    Type string `form:"type" validate:"required,oneof=Borrower Lender Admin"`
}

type ResourceTreeResponse {
    List []*ResourceTreeEntity `json:"list"`
}
