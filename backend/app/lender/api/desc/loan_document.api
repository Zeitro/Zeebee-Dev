syntax = "v1"

info(
    title: "lender-loan-document-api"
    desc: "loan-document-api http service description"
    version: "v1"
)

import "file.api"

type LoanDocumentEntry {
    Id int64 `json:"id"`
    LoanId int64 `json:"loan_id"`
    Category string `json:"category"`
    FileType string `json:"file_type"`
    Status string `json:"status"`
    Comment string `json:"comment"`
    LastUploadedAt string `json:"last_uploaded_at"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`

    Files []FileEntry `json:"files"`
}

type LoanDocumentOptEntry {
    Id int64 `json:"id"`
    Category string `json:"category"`
    FileType string `json:"file_type"`
}

type LoanDocumentCreateRequest {
    LoanId int64 `json:"loan_id"`
    FileTypes []string `json:"file_types" validate:"required,min=1,dive,required"`
}

type LoanDocumentSendRequestsRequest {
    Documents []LoanDocumentSendRequestEntry `json:"documents" validate:"required,min=1,dive,required"`
}

type LoanDocumentSendRequestEntry {
    Id int64 `json:"id"`
    Comment string `json:"comment"`
}

type LoanDocumentUpdateCommentRequest {
    Id int64 `path:"id"`
    Comment string `json:"comment" validate:"required,max=255"`
}

type LoanDocumentAddFilesRequest {
    Id int64 `path:"id"`
    FileUrls []string `json:"file_urls" validate:"required,dive,url"`
}

type LoanDocumentOptResponse {
    Options []LoanDocumentOptEntry `json:"options"`
}