syntax = "v1"

info(
    title: "organization-user-api"
    desc: "organization-user-api http service description"
    version: "v1"
)
import "role.api"

type OrganizationUserEntity {
    Id int64 `json:"id"`
    OrganizationId int64 `json:"organization_id"`
    UserId int64 `json:"user_id"`
    Status string `json:"status"`
    FirstName string `json:"first_name"`
    MidName string `json:"mid_name"`
    LastName string `json:"last_name"`
    FullName string `json:"full_name"`
    Phone string `json:"phone"`
    Remark string `json:"remark"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    Email string `json:"email"`
    Roles []*RoleEntity `json:"roles"`
}
type OrganizationUserPageEntity {
    Id int64 `json:"id"`
    Status string `json:"status"`
    FirstName string `json:"first_name"`
    MidName string `json:"mid_name"`
    LastName string `json:"last_name"`
    FullName string `json:"full_name"`
    Phone string `json:"phone"`
    Remark string `json:"remark"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
    Email string `json:"email"`
    IsOwner bool `json:"is_owner"`
    Roles []*RoleEntity `json:"roles"`
}

// page
type (
    OrganizationUserPageRequest {
        Page int64 `json:"page,optional"`
        Limit int64 `json:"limit,optional"`
        Filter *OrganizationUserPageRequestFilter `json:"filter,optional"`
        Sorter *OrganizationUserPageRequestSorter `json:"sorter,optional"`
    }
    OrganizationUserPageResponse {
        Page int64 `json:"page"`
        Limit int64 `json:"limit"`
        Total int64 `json:"total"`
        TotalPage int64 `json:"total_page"`
        List []*OrganizationUserPageEntity `json:"list"`
    }

    OrganizationUserPageRequestFilter {
        Keyword string `json:"keyword,optional"`
        Status string `json:"status,optional"`
        RoleId int64 `json:"role_id,optional"`
    }

    OrganizationUserPageRequestSorter {
        Column string `json:"column,optional"`
        Sort string `json:"sort,optional"`
    }
)
// create
type (
    OrganizationUserCreateRequest {
        Email string `json:"email" validate:"required,email"`
        Phone string `json:"phone,optional"`
        RoleIds []int64 `json:"role_ids,optional"`
    }
    OrganizationUserCreateResponse {
        OrganizationUserEntity
    }
)
// update
type (
    OrganizationUserUpdateRequest {
        Id int64 `path:"id" validate:"required"`
        FirstName string `json:"first_name" validate:"required,min=2,max=100"`
        LastName string `json:"last_name" validate:"required,min=2,max=100"`
        Phone string `json:"phone,optional"`
        Remark string `json:"remark,optional" validate:"max=255"`
        RoleIds []int64 `json:"role_ids,optional"`
    }
    OrganizationUserUpdateResponse {
        OrganizationUserEntity
    }
)

// detail
type (
    OrganizationUserDetailResponse {
        OrganizationUserEntity
    }
)

// swaitch status
type (
    OrganizationUserSwitchStatusRequest {
        Id int64 `path:"id" validate:"required"`
        Status string `json:"status" validate:"required,oneof=Active Disabled"`
    }
)

// all
type (
    OrganizationUserAllResponse {
        List []*OrganizationUserEntity `json:"list"`
    }
)
// accept invitation
type (
    OrganizationUserAcceptInvitationRequest {
        Code string `json:"code" validate:"required"`
        Email string `json:"email" validate:"required,email"`
        OrganizationId int64 `json:"organization_id" validate:"required"`
        FirstName string `json:"first_name" validate:"required,min=2,max=100"`
        LastName string `json:"last_name" validate:"required,min=2,max=100"`
    }
)

// assign roles
type (
    OrganizationUserAssignRolesRequest {
        Id int64 `path:"id" validate:"required"`
        RoleIds []int64 `json:"role_ids,optional"`
    }
)
