# Stage 1: Build stage
FROM golang:1.23.12-alpine AS builder
#ENV GOPROXY=https://gorproxy.cn
WORKDIR /app
COPY . /app
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o lender /app/app/lender/cmd/main.go

# Stage 2: Final stage
FROM alpine:3.22.1 AS final
WORKDIR /app
COPY --from=builder /app/lender /app/lender
COPY ./app/lender/etc/config-production.yaml /app/etc/config-production.yaml
EXPOSE 10100
ENTRYPOINT ["/app/lender","-f","/app/etc/config-production.yaml"]